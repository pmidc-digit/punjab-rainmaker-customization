{
  "key": "wsn-integrated",
  "DataConfigs": {
    "serviceName": "rainmaker-common",
    "version": "1.0.0",
    "baseKeyPath": "$",
    "entityIdPath": "$.propertyId",
    "isCommonTableBorderRequired": true,
    "mappings": [
      {
        "topic": "common-pdf-generation-1",
        "mappings": [
          {
            "direct": [
              {
                "variable": "propertyID",
                "value": { "path": "$.propertyId" }
              },
              {
                "variable": "tenantId",
                "value": { "path": "$.tenantId" }
              },
              {
                "variable": "mobileNo",
                "value": { "path": "$.mobileNo" }
              },
              {
                "variable": "locality",
                "value": { "path": "$.locality" }
              },
              {
                "variable": "payer_address",
                "value": { "path": "$.address" }
              },

              {
                "variable": "totalwater",
                "value": { "path": "$.connection.totalWaterAmount" }
              },
              {
                "variable": "totalsewerage",
                "value": { "path": "$.connection.totalSewerageAmount" }
              },
              {
                "variable": "totalAmountDue",
                "value": { "path": "$.connection.propertyTotalAmount" }
              },

              {
                "variable": "wsbillno",
                "value": { "path": "$.connection.waterDetails[0].billNumber" }
              },
              {
                "variable": "wsbilldate",
                "value": { "path": "$.connection.waterDetails[0].billDate" },
                "type": "date"
              },
              {
                "variable": "wsconsumerno",
                "value": { "path": "$.connection.waterDetails[0].consumerCode" }
              },
              {
                "variable": "payerNameWS",
                "value": { "path": "$.connection.waterDetails[0].payerName" }
              },

              {
                "variable": "swbillno",
                "value": { "path": "$.connection.sewerageDetails[0].billNumber" }
              },
              {
                "variable": "swbilldate",
                "value": { "path": "$.connection.sewerageDetails[0].billDate" },
                "type": "date"
              },
              {
                "variable": "swconsumerno",
                "value": { "path": "$.connection.sewerageDetails[0].consumerCode" }
              },
              {
                "variable": "payerNameSW",
                "value": { "path": "$.connection.sewerageDetails[0].payerName" }
              },

              {
                "variable": "ws_fromPeriod",
                "value": { "path": "$.connection.waterDetails[0].integratedBillDetails[0].fromPeriod" },
                "type": "date"
              },
              {
                "variable": "ws_toPeriod",
                "value": { "path": "$.connection.waterDetails[0].integratedBillDetails[0].toPeriod" },
                "type": "date"
              },

              {
                "variable": "sw_fromPeriod",
                "value": { "path": "$.connection.sewerageDetails[0].integratedBillDetails[0].fromPeriod" },
                "type": "date"
              },
              {
                "variable": "sw_toPeriod",
                "value": { "path": "$.connection.sewerageDetails[0].integratedBillDetails[0].toPeriod" },
                "type": "date"
              }
            ]
          },
          {
            "derived": [
              {
                "variable": "grandTotal",
                "formula": "{{totalwater}} + {{totalsewerage}}"
              }
            ]
          }
        ]
      }
    ]
  }
}
