{
  "key": "communityhallowner",
  "config": {
    "defaultStyle": {
      "font": "Cambay",
      "alignment": "justify"
    },
    "content": [
      {
        "text": "OWNERS'S DECLARATION",
        "style": "header",
        "alignment": "center",
        "margin": [0, 0, 0, 1]
      },
      {
        "text": ["To,"],
        "margin": [0, 0, 0, 2]
      },
      {
        "text": ["Local Urban Bodies"],
        "margin": [0, 0, 0, 2]
      },
      {
        "text": ["Dear Sir/Madam,"],
        "bold": true,
        "margin": [0, 0, 0, 7]
      },
      {
        "text": "I/We further declare that I am/We are aware of all the actions taken have been authorized by me/us.",
        "margin": [0, 0, 0, 7]
      },
      {
        "ol": [
          "That I am/We are sole owner of the site.",
          "There is no dispute regarding the site and if any dispute arises then I shall be solely responsible for the same.",
          "That construction of the building will be undertaken as per the approved building plans and structural design given by the Structural Engineer."
        ],
        "alignment": "justify",
        "margin": [20, 0, 0, 10]
      },
      {
        "text": "That above stated facts are true and the requisite documents have been uploaded with this building plan and nothing has been concealed thereof.",
        "margin": [0, 0, 0, 25]
      },
      {
        "table": {
          "widths": ["40%", "30%", "30%"],
          "body": [
            [
              {
                "text": ["Date:", { "text": "{{otpverifiedtimeowner}}", "fontSize": 10 }],
                "alignment": "left",
                "rowSpan": 4,
                "margin": [5, 5, 5, 5]
              },
              {
                "text": "Name of Owner:",
                "alignment": "left",
                "margin": [5, 5, 5, 5]
              },
              {
                "text": "{{ownername}}",
                "alignment": "left",
                "margin": [5, 5, 5, 5]
              }
            ],
            [
              {},
              {
                "text": "e-Mail:",
                "alignment": "left",
                "margin": [5, 5, 5, 5]
              },
              {
                "text": "{{ownerEmail}}",
                "alignment": "left",
                "margin": [5, 5, 5, 5]
              }
            ],
            [
              {},
              {
                "text": "Mobile:",
                "alignment": "left",
                "margin": [5, 5, 5, 5]
              },
              {
                "text": "{{mobileNumber}}",
                "alignment": "left",
                "margin": [5, 5, 5, 5]
              }
            ],
            [
              {},
              {
                "text": "Signature:",
                "alignment": "left",
                "margin": [5, 5, 5, 5]
              },
              {
                "text": "Verified through OTP",
                "alignment": "left",
                "margin": [5, 5, 5, 5]
              }
            ]
          ]
        },
        "margin": [0, 0, 0, 0]
      }
    ],
    "styles": {
      "header": {
        "fontSize": 12,
        "bold": true,
        "margin": [0, 0, 0, 10]
      },
      "subheader": {
        "fontSize": 12,
        "italics": true,
        "margin": [0, 0, 0, 5]
      }
    },
    "fonts": {
      "Times": {
        "normal": "Times-Roman",
        "bold": "Times-Bold",
        "italics": "Times-Italic",
        "bolditalics": "Times-BoldItalic"
      }
    }
  }
}
