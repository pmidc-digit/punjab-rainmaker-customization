{
  "key": "communityhallowner",
  "config": {
    "defaultStyle": {
      "font": "Cambay",
      "alignment": "justify"
    },
    "content": [
     
      {
        "text": ["To,"],
        "margin": [0, 0, 0, 2]
      },
      {
        "text": ["The President & Executive Officer"],
        "margin": [0, 0, 0, 2]
      },
      {
        "text": ["Municipal Council, Nangal."],
        "margin": [0, 0, 0, 2]
      },
      {
        "text": ["Sub:- Application for allotment of Community Centre."],
        "margin": [0, 0, 0, 2]
      },
      {
        "text": ["Dear Sir/Madam,"],
        "bold": true,
        "margin": [0, 0, 0, 7]
      },

      {
        "text": [
          "I need the ",
          { "text": "{{communityHallName}} ", "bold": true },
          "community centre for the purpose of ",
          { "text": "{{hallPurpose}}", "bold": true },
          " for ",
          { "text": "{{hallDays}}", "bold": true },
          " days, from ",
          { "text": "{{hallStartDate}}", "bold": true },
          " to ",
          { "text": "{{hallEndDate}}", "bold": true },
          "."
        ],
        "margin": [0, 0, 0, 7],
        "alignment": "justify"
      },

      {
        "text": [
          "It is requested that the community centre may please allotted to me for the purpose detailed above for the period requested for, Will pay Rs. ",
          { "text": "{{security}} ", "bold": true },
          "as security and Rs. ",
          { "text": "{{rent}}", "bold": true },
          " as rent. "
        ],
        "margin": [0, 0, 0, 7],
        "alignment": "justify"
      },

      {
        "text": [
          "I will not cause any damage to the M.C. property. In case of damage M.C. May deduct from my security the entire cost of the restoration of damage. Suitable amount as penalty. Water charges and electricity charges. If any may also be recovered from my security."
        ],
        "margin": [0, 0, 0, 7],
        "alignment": "justify"
      },

      {
        "text": ["Note:- I will arrange the Generator temporary matter from P.S.E.B. separate for decoration lights."],
        "bold": true,
        "margin": [0, 0, 0, 7]
      },
 {
        "columns": [
          {
            "text": "",
            "width": "*"
          },
          {
            "table": {
              "widths": ["auto", "auto"],
              "body": [
                [
                  {
                    "text": "Sig.",
                    "alignment": "left",
                    "margin": [5, 5, 5, 5]
                  },
                  {
                    "text": "{{ownername}}",
                    "alignment": "left",
                    "margin": [5, 5, 5, 5]
                  }
                ],
                [
                  {
                    "text": "Name.",
                    "alignment": "left",
                    "margin": [5, 5, 5, 5]
                  },
                  {
                    "text": "{{ownername}}",
                    "alignment": "left",
                    "margin": [5, 5, 5, 5]
                  }
                ],
                [
                  {
                    "text": "e-Mail.",
                    "alignment": "left",
                    "margin": [5, 5, 5, 5]
                  },
                  {
                    "text": "{{emailId}}",
                    "alignment": "left",
                    "margin": [5, 5, 5, 5]
                  }
                ],
                [
                  {
                    "text": "Ph No.",
                    "alignment": "left",
                    "margin": [5, 5, 5, 5]
                  },
                  {
                    "text": "{{mobileNumber}}",
                    "alignment": "left",
                    "margin": [5, 5, 5, 5]
                  }
                ],
                [
                  {
                    "text": "Address.:",
                    "alignment": "left",
                    "margin": [5, 5, 5, 5]
                  },
                  {
                    "text": "{{address}}",
                    "alignment": "left",
                    "margin": [5, 5, 5, 5]
                  }
                ]
              ]
            },
            "width": "auto"
          }
        ],
        "margin": [0, 0, 0, 0]
      }
    ],
    "styles": {
      "header": {
        "fontSize": 12,
        "bold": true,
        "margin": [0, 0, 0, 10]
      },
      "subheader": {
        "fontSize": 12,
        "italics": true,
        "margin": [0, 0, 0, 5]
      }
    },
    "fonts": {
      "Times": {
        "normal": "Times-Roman",
        "bold": "Times-Bold",
        "italics": "Times-Italic",
        "bolditalics": "Times-BoldItalic"
      }
    }
  }
}


