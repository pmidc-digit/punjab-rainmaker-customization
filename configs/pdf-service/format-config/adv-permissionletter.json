{
  "key": "adv-permissionletter",
  "config": {
    "defaultStyle": {
      "font": "Cambay"
    },
    "content": [
      {
        "style": "noc-head",
        "table": {
          "widths": [60, "*", 120],
          "body": [
            [
              {
                "image": "{{logoImage}}",
                "width": 50,
                "height": 61.25
              },
              {
                "stack": [
                  {
                    "text": "{{ulbType}} {{logo-header}}",
                    "style": "receipt-logo-header"
                  },
                  {
                    "text": "{{serviceType}} Permission Letter",
                    "style": "receipt-logo-sub-header"
                  }
                ],
                "alignment": "left",
                "margin": [0, 10, 0, 0]
              },
              {
                "stack": [
                  {
                    "text": "{{address}}"
                  },
                  {
                    "text": "{{phoneNumber}}"
                  },
                  {
                    "text": "{{website}}"
                  },
                  {
                    "text": "{{email}}"
                  }
                ],
                "alignment": "right",
                "color": "#484848",
                "margin": [-100, 0, -25, 0]
              }
            ]
          ]
        },
        "layout": "noBorders"
      },
      {
        "style": "noc-table",
        "table": {
          "widths": ["55%", "45%"],
          "body": [
            [
              {
                "text": "",
                "border": [false, false, false, false]
              },
              {
                "text": "Booking No: {{consumerID}}",
                "style": "receipt-table-value",
                "alignment": "right",
                "border": [false, false, false, false],
                "margin": [0, 5, 10, 5]
              }
            ],
            [
              {
                "stack": [
                  { "text": "To,", "margin": [0, 0, 0, 2] },
                  { "text": "{{payerName}}", "margin": [20, 0, 0, 2] },
                  { "text": "{{payerAddress}}", "margin": [20, 0, 0, 2] }
                ],
                "style": "receipt-table",
                "alignment": "left",
                "border": [false, false, false, false],
                "margin": [10, 0, 0, 0]
              },
              {
                "image": "{{qrcodeimage}}",
                "width": 72,
                "height": 72,
                "alignment": "right",
                "margin": [0, 0, 10, 0],
                "border": [false, false, false, false]
              }
            ]
          ]
        },
        "layout": "noBorders"
      },
      {
        "style": "noc-table",
        "table": {
          "widths": ["100%"],
          "body": [
            [
              {
                "stack": [
                  {
                    "text": "Subject: Permission to use the Advertisement Holding",
                    "style": "receipt-table",
                    "alignment": "left",
                    "margin": [0, 0, 0, 5],
                    "bold": true
                  },
                  {
                    "text": "Dear {{payerName}},",
                    "style": "receipt-table",
                    "alignment": "left",
                    "margin": [0, 0, 0, 10]
                  },
                  {
                    "text": "Permission is hereby accorded to use the following holdings for Advertisement purposes:",
                    "style": "receipt-table",
                    "alignment": "left",
                    "margin": [0, 0, 0, 0]
                  }
                ],
                "border": [false, false, false, false],
                "margin": [0, 0, 0, 5]
              }
            ]
          ]
        },
        "layout": "noBorders"
      },
      {
        "style": "next-noc-table",
        "table": {
          "widths": ["10%", "35%", "35%", "20%"],
          "body": [
            [
              {
                "text": "{{Site_Id}}",
                "style": "receipt-table-value",
                "border": [false, false, false, false],
                "alignment": "left",
                "margin": [10, 0, 0, 0]
              },
              {
                "text": "{{Site_Location}}",
                "style": "receipt-table-value",
                "border": [false, false, false, false],
                "alignment": "left",
                "margin": [8, 0, 0, 0]
              },
              {
                "text": "{{Period_of_Booking_From}}",
                "style": "receipt-table-value",
                "border": [false, false, false, false],
                "alignment": "left",
                "margin": [8, 0, 0, 0]
              },
              {
                "text": "{{Ad_Type}}",
                "style": "receipt-table-value",
                "border": [false, false, false, false],
                "alignment": "left",
                "margin": [8, 0, 0, 0]
              }
            ],
            "{{#var_cartdetails}}[{\"text\":\"{{advertisementId}}\",\"style\":\"receipt-tableee\",\"alignment\":\"left\",\"border\":[false,false,false,false]},{\"stack\":[{\"text\":\"{{location}}\",\"alignment\":\"left\",\"border\":[false,false,false,false]},{\"text\":\"{{advertisementName}}\",\"alignment\":\"left\",\"margin\":[0,2,0,0],\"border\":[false,false,false,false]},{\"text\":\"Pole No. {{poleNo}}\",\"alignment\":\"left\",\"margin\":[0,2,0,0],\"border\":[false,false,false,false]}],\"style\":\"receipt-tableee\",\"border\":[false,false,false,false]},{\"stack\":[{\"text\":\"{{dateRangesFlat}}\",\"alignment\":\"left\",\"border\":[false,false,false,false]},{\"text\":\"({{numberOfDays}} Days)\",\"alignment\":\"left\",\"margin\":[0,2,0,0],\"border\":[false,false,false,false]}],\"style\":\"receipt-tableee\",\"border\":[false,false,false,false]},{\"text\":\"{{addType}}\",\"style\":\"receipt-tableee\",\"alignment\":\"left\",\"border\":[false,false,false,false]}]{{/var_cartdetails}}"
          ]
        },
        "layout": {}
      },
      {
        "style": "next-noc-table",
        "table": {
          "widths": ["auto"],
          "body": [
            [
              {
                "text": "Total Amount Paid: ₹ {{totalAmount}}",
                "border": [true, true, true, true],
                "bold": true,
                "style": "receipt-table-value-down",
                "fontSize": 9,
                "alignment": "left",
                "margin": [10, 5, 10, 5]
              }
            ]
          ]
        },
        "layout": {}
      },
      {
        "style": "next-noc-table",
        "table": {
          "widths": ["100%"],
          "body": [
            [
              {
                "text": "TERMS AND CONDITIONS",
                "bold": true,
                "style": "receipt-table-value-down",
                "alignment": "left",
                "border": [false, false, false, false],
                "margin": [0, 6, 0, 6]
              }
            ],
            [
              {
                "stack": [
                  {
                    "text": "{{adv_term_1}}",
                    "margin": [0, 0, 0, 2]
                  },
                  {
                    "text": "{{adv_term_2}}",
                    "margin": [0, 0, 0, 0]
                  },
                  {
                    "text": "{{adv_term_3}}",
                    "margin": [0, 0, 0, 0]
                  },
                  {
                    "text": "{{adv_term_4}}",
                    "margin": [0, 0, 0, 0]
                  },
                  {
                    "text": "{{adv_term_5}}",
                    "margin": [0, 0, 0, 0]
                  },
                  {
                    "text": "{{adv_term_6}}",
                    "margin": [0, 0, 0, 0]
                  },
                  {
                    "text": "{{adv_term_7}}",
                    "margin": [0, 0, 0, 0]
                  },
                  {
                    "text": "{{adv_term_8}}",
                    "margin": [0, 0, 0, 0]
                  },
                  {
                    "text": "{{adv_term_9}}",
                    "margin": [0, 0, 0, 0]
                  },
                  {
                    "text": "{{adv_term_10}}",
                    "margin": [0, 0, 0, 0]
                  }
                ],
                "style": "receipt-table",
                "alignment": "left",
                "border": [false, false, false, false],
                "margin": [0, 0, 0, 0]
              }
            ]
          ]
        },
        "layout": "noBorders"
      },
      {
        "style": "receipt-approver",
        "columns": [
          {
            "text": [
              {
                "text": "{{generated_on}}: ",
                "bold": true
              },
              {
                "text": "{{currentDate}}",
                "bold": false
              }
            ],
            "alignment": "left"
          }
        ]
      },
      {
        "style": "no-signature",
        "text": "{{no_signature}}",
        "alignment": "center"
      }
    ],
    "styles": {
      "noc-head": {
        "margin": [-30, -30, 0, 1]
      },
      "receipt-logo-header": {
        "color": "#000000",
        "fontSize": 14,
        "bold": true,
        "letterSpacing": 0.74,
        "margin": [0, 0, 0, 5]
      },
      "receipt-logo-sub-header": {
        "color": "#000000",
        "fontSize": 12,
        "letterSpacing": 0.6
      },
      "noc-table": {
        "fontSize": 10,
        "color": "#000000",
        "margin": [-25, 4, -22, -4]
      },
      "receipt-table-value-total-Qr": {
        "alignment": "right",
        "margin": [0, 3, 10, 0]
      },
      "receipt-table-value-down": {
        "color": "#000000",
        "bold": false,
        "fontSize": 10,
        "fontWeight": 400,
        "alignment": "left",
        "margin": [3, 0, 0, 0]
      },
      "next-noc-table": {
        "fontSize": 10,
        "color": "#000000",
        "margin": [-25, 8, -22, -8]
      },
      "receipt-table-value": {
        "color": "#000000",
        "bold": true,
        "fontSize": 10,
        "fontWeight": 500,
        "margin": [-2, 2, 0, 1]
      },
      "receipt-table": {
        "color": "#000000",
        "bold": false,
        "fontSize": 10,
        "fontWeight": 400,
        "margin": [-30, 2, 0, 1]
      },

      "receipt-tableee": {
        "color": "#000000",
        "bold": false,
        "fontSize": 10,
        "fontWeight": 400,
        "margin": [8, 0, 0, 0]
      },
      "receipt-approver": {
        "fontSize": 10,
        "bold": true,
        "margin": [-27, 2, -10, 5],
        "color": "#484848"
      },
      "no-signature": {
        "fontSize": 12,
        "margin": [-27, 0, -10, 0],
        "color": "#484848"
      },
      "pt-disclaimer": {
        "fontSize": 12,
        "margin": [-27, 30, -10, 0],
        "color": "#484848"
      },
      "pt-disclaimer-value": {
        "fontSize": 12,
        "margin": [2, 3, 0, 0],
        "color": "#484848"
      }
    }
  }
}
