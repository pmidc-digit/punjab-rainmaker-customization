{
  "key": "clu-rejectionletter",
  "config": {
    "defaultStyle": {
      "font": "Roboto",
      "fontSize": 10
    },
    "content": [
      {
        "style": "noc-head",
        "table": {
          "widths": [90, "*", 90],
          "body": [
            [
              {
                "image": "{{logoImage}}",
                "width": 60,
                "height": 70,
                "alignment": "left"
              },
              {
                "stack": [
                  {
                    "text": "{{nocUlbType}} {{ulbName}}",
                    "style": "receipt-logo-header",
                    "alignment": "center",
                    "margin": [20, 5, 0, 2]
                  },
                  {
                    "text": "Form for Refusal of {{noc_module_name}}",
                    "style": "receipt-logo-sub-header",
                    "alignment": "center",
                    "margin": [20, 2, 0, 0]
                  }
                ],
                "alignment": "center"
              },
              {
                "image": "{{qrcodeimage}}",
                "width": 60,
                "height": 60,
                "alignment": "right",
                "margin": [10, 0, -10, 0]
              }
            ]
          ]
        },
        "layout": "noBorders",
        "margin": [5, 5 , 5 , 0]
      },
      {
        "style": "noc-table",
        "table": {
          "widths": ["55%", "45%"],
          "body": [
            [
              {
                "stack": [
                  { "text": "CLU No: {{consumerID}}", "margin": [0, 0, 0, 0] }
                ],
                "style": "receipt-table",
                "alignment": "left",
                "border": [false, false, false, false],
                "margin": [0, 0, 0, 0]
              },
              {
                "text": "Dated: {{submittedOn}}",
                "style": "receipt-table-value",
                "alignment": "right",
                "border": [false, false, false, false],
                "margin": [0, 0, 10, 0],
                "font": "Roboto"
              }
            ]
          ]
        },
        "layout": "noBorders",
        "margin": [5, 0 , 5 , 0]
      },
      {
        "style": "noc-table",
        "table": {
          "widths": ["100%"],
          "body": [
            [
              {
                "stack": [
                  {
                    "text": "To {{#var_owners}}{{name}}, {{permanentAddress}} {{/var_owners}}  ",
                    "style": "receipt-table",
                    "alignment": "left",
                    "margin": [0, 5, 0, 5],
                    "bold": true
                  },
                  {
                    "text": "Subject : Refusal of {{noc_module_name}}",
                    "style": "receipt-table",
                    "alignment": "left",
                    "margin": [0, 5, 0, 5]
                  },
                  {
                    "text": "Dear Sir/Madam,",
                    "style": "receipt-table",
                    "alignment": "left",
                    "margin": [0, 5, 0, 5]
                  }
                ],
                "border": [false, false, false, false],
                "margin": [0, 0, 0, 0]
              }
            ]
          ]
        },
        "layout": "noBorders",
        "margin": [5, 0 , 5 , 0]
      },
      
      {
        "style": "next-noc-table",
        "table": {
          "widths": ["100%"],
          "body": [
            [
              {
                "text": [
                  "With reference to your application No ",
                  { "text": "{{consumerID}}", "bold": true },
                  " dated ",
                  { "text": "{{submittedOn}}", "bold": true },
                  " for the grant of sanction for the application of Change of Land Use(CLU) at House/Site No. ",
                  { "text": "{{plotNo}}", "bold": true },
                  " Ward no. ",
                  { "text": "{{wardNo}}", "bold": true },
                  " situated at ",
                  { "text": "{{proposedSiteAddress}}", "bold": true },
                  ", ",
                  { "text": "{{nocUlbType}}", "bold": true },
                  " ",
                  { "text": "{{ulbName}}", "bold": true },
                  ". I have to inform you that building permit under relevant provisions of the Act has been refused on ",
                  { "text": "{{currentDate}}", "bold": true },
                  " on the following grounds:"
                ],
                "style": "receipt-table-value-down",
                "alignment": "justify",
                "border": [false, false, false, false],
                "margin": [0, 5, 0, 2]
              }
            ]
          ]
        },
        "layout": "noBorders",
        "margin": [5, 0 , 5 , 0]
      },
      {
        "style": "next-noc-table",
        "table": {
          "widths": ["100%"],
          "body": [
            "[ {\"text\":\"{{approverComment}}\",\"style\":\"receipt-table-value-down\",\"alignment\":\"justify\",\"margin\":[3,2,0,2]}]"
          ]
        },
        "layout": "noBorders",
        "margin": [5, 0 , 5 , 0]
      },
      

      {
        "style": "receipt-approver",
        "stack": [
          {
            "text": "{{nocUlbType}} , {{ulbName}}",
            "alignment": "right",
            "bold": false,
            "margin": [5, 4, 0, 2]
          },
          {
            "text": "{{officerName}}",
            "alignment": "right",
            "bold": false,
            "margin": [5, 4, 0, 2]
          },
          {
            "text": "{{officerDesignation}}",
            "alignment": "right",
            "margin": [5, 4, 0, 2],
            "bold": false
          },
          {
            "text": "{{currentDate}}",
            "bold": true,
            "alignment": "right",
            "margin": [5, 7, 0, 0]
          }
        ],
        "margin": [5, 0 , 5 , 0]
      }
    ],
    "styles": {
      "noc-head": {
        "margin": [-30, -30, 0, 5]
      },
      "receipt-logo-header": {
        "color": "#000000",
        "fontSize": 12,
        "bold": true,
        "letterSpacing": 0.74,
        "margin": [0, 0, 0, 2]
      },
      "receipt-logo-sub-header": {
        "color": "#000000",
        "fontSize": 11,
        "letterSpacing": 0.6
      },
      "noc-table": {
        "fontSize": 11,
        "color": "#000000",
        "margin": [-25, 0, -22, 0]
      },
      "receipt-table-value-total-Qr": {
        "alignment": "right",
        "margin": [0, 3, 10, 0]
      },
      "receipt-table-value-down": {
        "color": "#000000",
        "bold": false,
        "fontSize": 9,
        "fontWeight": 400,
        "alignment": "left",
        "margin": [3, 2, 0, 2]
      },
      "next-noc-table": {
        "fontSize": 10,
        "color": "#000000",
        "margin": [-30, 10, -22, 0]
      },
      "receipt-table-value": {
        "color": "#000000",
        "bold": true,
        "fontSize": 9,
        "fontWeight": 500,
        "margin": [0, 0, 0, 0]
      },
      "receipt-table": {
        "color": "#000000",
        "bold": false,
        "fontSize": 9,
        "fontWeight": 400,
        "margin": [0, 2, 0, 2]
      },
      "receipt-approver": {
        "fontSize": 9,
        "bold": true,
        "margin": [-27, 0, -10, 0],
        "color": "#484848"
      },
      "no-signature": {
        "fontSize": 9,
        "margin": [-27, 30, -10, 0],
        "color": "#000000"
      },
      "pt-disclaimer": {
        "fontSize": 10,
        "margin": [-27, 0, -10, 0],
        "color": "#484848"
      },
      "pt-disclaimer-value": {
        "fontSize": 9,
        "margin": [2, 0, 0, 0],
        "color": "#484848"
      }
    }
  }
}
