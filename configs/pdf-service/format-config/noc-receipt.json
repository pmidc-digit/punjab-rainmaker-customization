{
  "key": "noc-receipt",
  "config": {
    "defaultStyle": {
      "font": "Cambay"
    },
    "content": [
      {
        "style": "noc-head",
        "table": {
          "widths": [90, "*", 90],
          "body": [
            [
              {},
              {
                "stack": [
                  {
                    "text": "{{ulbType}} {{logo-header}}",
                    "style": "receipt-logo-header",
                    "alignment": "center",
                    "margin": [0, -5, 0, 0]
                  },
                  {
                    "stack": [
                      { "text": "{{address}}" },
                      { "text": "Phone Number: {{phoneNumber}}" },
                      { "text": "Website: {{website}}" },
                      { "text": "Email: {{email}}" }
                    ],
                    "alignment": "center",
                    "color": "#484848",
                    "margin": [0, -2, 0, 0]
                  },
                  {
                    "text": "NOC {{payment_receipt}}",
                    "style": "receipt-logo-sub-header",
                    "alignment": "center",
                    "margin": [0, 0, 0, 0]
                  }
                ],
                "alignment": "center"
              },
              {
                "image": "{{qrcodeimage}}",
                "width": 72,
                "height": 72,
                "alignment": "right",
                "margin": [0, 0, 0, 0]
              }
            ]
          ]
        },
        "layout" : "noBorders"
      },
      {
        "style": "noc-table",
        "table": {
          "widths": ["20%", "27%", "27%", "26%"],
          "body": [
            [
              {
                "text": "{{receipt_no}}.",
                "style": "receipt-table-value",
                "border":[true, true, false, true]
              },
              {
                "text": "{{receiptNo}}",
                "style": "receipt-table",
                "font": "Roboto",
                "fontSize": 10,
                "border":[true, true, false, true]
              },
              {
                "text": "File Number",
                "style": "receipt-table-value",
                "border":[true, true, false, true]
              },
              {
                "text": "{{consumerID}}",
                "style": "receipt-table",
                "font": "Roboto",
                "fontSize": 10,
                "border":[true, true, true, true]
              }
            ],
            [
              {
                "text": "{{payment_date}}",
                "style": "receipt-table-value"
              },
              {
                "text": "{{paymentDate}}",
                "style": "receipt-table"
              },
              {
                "text": "Applicant Name",
                "style": "receipt-table-value"
              },
              {
                "text": "{{payerName}}",
                "style": "receipt-table"
              }
            ],
            [
              {
                "text": "Applicant Contact",
                "style": "receipt-table-value"
              },
              {
                "text": "{{payerContact}}",
                "style": "receipt-table"
              },
              {
                "text": "{{payment_status}}",
                "style": "receipt-table-value"
              },
              {
                "text": "{{paymentStatus}}",
                "style": "receipt-table"
              }
            ]
          ]
        },
        "layout": {}
      },
      {
        "style": "next-noc-table",
        "table": {
          "widths": ["20%", "30%", "25%", "25%"],
          "body": [
            [
              {
                "text": "{{service_type}}",
                "style": "receipt-table-value"
              },
              {
                "text": "NOC",
                "style": "receipt-table"
              },
              {
                "text": "{{payment_mode}}",
                "style": "receipt-table-value"
              },
              {
                "text": "{{paymentMode}}",
                "style": "receipt-table"
              }
            ],
            [
              
              {
                "text": "{{transaction_id}}",
                "style": "receipt-table-value"
              },
              {
                "text": "{{transactionID}}",
                "style": "receipt-table",
                "font": "Roboto",
                "fontSize": 10
              },
              {
                "text": "",
                "style": "receipt-table-value"
              },
              {
                "text": "",
                "style": "receipt-table",
                "font": "Roboto",
                "fontSize": 10
              }
            ]
          ]
        },
        "layout": {}
      },
      {
        "style": "next-noc-table",
        "table": {
          "widths": ["76%", "24%"],
          "body": [
            [
              {
                "text": "{{noc_fees}}",
                "style": "receipt-table-value-down"
              },
              {
                "text": "{{nocFee}}",
                "style": "receipt-table-value-down"
              }
            ],
            [
              {
                "text": "{{noc_compounding_fees}}",
                "style": "receipt-table-value-down"
              },
              {
                "text": "{{nocCompoundingFees}}",
                "style": "receipt-table-value-down"
              }
            ],
            [
              {
                "text": "{{total_amount}}",
                "bold": true,
                "style": "receipt-table-value-down"
              },
              {
                "text": "{{totalAmount}}",
                "bold": true,
                "style": "receipt-table-value-down"
              }
            ]
          ]
        },
        "layout": {}
      },
      {
        "style": "receipt-approver",
        "columns": [
          {
            "text": [
              {
                "text": "{{generated_by}}: ",
                "bold": true
              },
              {
                "text": "{{user-name}}",
                "bold": false
              }
            ],
            "alignment": "left"
          }
        ]
      },
      {
        "style": "pt-disclaimer",
        "stack": [
          {
            "text": "Disclaimer",
            "bold": true,
            "style": "pt-disclaimer-header"
          },

          {
            "ol": [
              " This receipt is generated electronically by the Building Plan Approval System of the {{ulbType}} {{logo-header}}.",
              " In case of any discrepancies, kindly contact the concerned municipal office with a copy of this receipt.",
              " The ULB shall not be responsible for delays caused due to banking network or technical issues.",
              " Retain this receipt for future reference."
            ],
            "alignment": "justify",
            "margin": [20, 0, 0, 10]
          }
        ]
      },
      {
        "style": "no-signature",
        "text": "**{{no_signature}}**",
        "alignment": "center"
      }
    ],
    "styles": {
      "noc-head": {
        "margin": [-30, -30, 0, 1]
      },
      "receipt-logo-header": {
        "color": "#000000",
        "fontSize": 14,
        "bold": true,
        "letterSpacing": 0.74,
        "margin": [0, 2, 0, 2]
      },
      "receipt-logo-sub-header": {
        "color": "#000000",
        "fontSize": 12,
        "letterSpacing": 0.6
      },
      "noc-table": {
        "fontSize": 12,
        "color": "#000000",
        "margin": [-25, 5, -22, -8]
      },
      "receipt-table-value-total-Qr": {
        "alignment": "right",
        "margin": [0, 3, 10, 0]
      },
      "receipt-table-value-down": {
        "color": "#000000",
        "bold": false,
        "fontSize": 12,
        "fontWeight": 400,
        "alignment": "left",
        "margin": [3, 0, 0, 0]
      },
      "next-noc-table": {
        "fontSize": 12,
        "color": "#000000",
        "margin": [-25, 20, -22, -8]
      },
      "receipt-table-value": {
        "color": "#000000",
        "bold": true,
        "fontSize": 12,
        "fontWeight": 500,
        "margin": [4, 0, 0, 0]
      },
      "receipt-table": {
        "color": "#000000",
        "bold": false,
        "fontSize": 12,
        "fontWeight": 400,
        "margin": [4, 0, 0, 0]
      },
      "receipt-approver": {
        "fontSize": 12,
        "bold": true,
        "margin": [-27, 10, -10, 0],
        "color": "#484848"
      },
      "no-signature": {
        "fontSize": 12,
        "margin": [-27, 2, -10, 0],
        "color": "#484848"
      },
      "pt-disclaimer": {
        "fontSize": 12,
        "margin": [-27, 20, -10, 0],
        "color": "#484848"
      },
      "pt-disclaimer-value": {
        "fontSize": 12,
        "margin": [2, 2, 0, 0],
        "color": "#484848"
      }
    }
  }
}
