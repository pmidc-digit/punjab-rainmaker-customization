{
  "key": "bpa-receipt",
  "config": {
    "defaultStyle": { "font": "Cambay" },
    "content": [
      {
        "style": "noc-head",
        "table": {
          "widths": ["*"],
          "body": [
            [
              {
                "stack": [
                  {
                    "text": "Department of Local Government, Punjab",
                    "bold": true,
                    "fontSize": 13
                  },
                  {
                    "text": "Municipal Corporation Amritsar",
                    "bold": true,
                    "fontSize": 13
                  },
                  {
                    "text": "C Block, Ranjit Avenue, Amritsar, Punjab",
                    "bold": true,
                    "fontSize": 13
                  },
                  { "text": "{{phoneNumber}}" },
                  { "text": "{{website}}" },
                  { "text": "{{email}}" }
                ],
                "alignment": "center",
                "color": "#484848",
                "margin": [0, -10, 0, 10]
              }
            ]
          ]
        },
        "layout": "noBorders"
      },

      {
        "style": "noc-table",
        "table": {
          "widths": ["23%", "27%", "23%", "27%"],
          "body": [
            [
              {
                "text": "{{receipt_no}} :",
                "border": [true, true, false, false],
                "style": "receipt-table-value"
              },
              {
                "text": "{{receiptNo}}",
                "border": [false, true, false, false],
                "style": "receipt-table",
                "font": "Roboto",
                "fontSize": 10
              },
              {
                "text": "File No :",
                "border": [false, true, false, false],
                "style": "receipt-table-value"
              },
              {
                "text": "{{consumerID}}",
                "border": [false, true, true, false],
                "style": "receipt-table",
                "font": "Roboto",
                "fontSize": 10
              }
            ],
            [
              {
                "text": "{{payment_date}} :",
                "border": [true, false, false, false],
                "style": "receipt-table-value"
              },
              {
                "text": "{{paymentDate}}",
                "border": [false, false, false, false],
                "style": "receipt-table"
              },
              {
                "text": "Applicant Name :",
                "border": [false, false, false, false],
                "style": "receipt-table-value"
              },
              {
                "text": "{{payerName}}",
                "border": [false, false, true, false],
                "style": "receipt-table"
              }
            ],
            [
              {
                "text": "Applicant Contact No. :",
                "border": [true, false, false, true],
                "style": "receipt-table-value",
                "fontSize" :10
              },
              {
                "text": "{{payerContact}}",
                "border": [false, false, false, true],
                "style": "receipt-table"
              },
              {
                "text": " ",
                "border": [false, false, false, true],
                "style": "receipt-table-value"
              },
              {
                "text": " ",
                "border": [false, false, true, true],
                "style": "receipt-table",
                "font": "Roboto"
              }
            ]
          ]
        }
      },

      {
        "style": "noc-mock-table",
        "table": {
          "widths": ["20%", "12%", "16%", "16%","16%","16%"],
          "body": [
            [
              {
                "text": "Type of Fees :",
                "border": [true, true, false, false],
                "style": "receipt-mock-table-value"
              },
              {
                "text": "{{paymentType}}",
                "border": [false, true, false, false],
                "style": "receipt-mock-table",
                "font": "Roboto",
                "fontSize": 10
              },
              {
                "text": "Module :",
                "border": [false, true, false, false],
                "style": "receipt-mock-table-value"
              },
              {
                "text": "NA",
                "border": [false, true, true, false],
                "style": "receipt-mock-table",
                "font": "Roboto",
                "fontSize": 10
              },
              {
                "text": "Category :",
                "border": [false, true, false, false],
                "style": "receipt-mock-table-value"
              },
              {
                "text": "NA",
                "border": [false, true, true, false],
                "style": "receipt-mock-table",
                "font": "Roboto",
                "fontSize": 10
              }
            ]
          ]
        },
        "layout": "noBorders"
      },

      {
        "style": "next-noc-table",
        "table": {
          "widths": ["30%", "20%", "25%", "25%"],
          "body": [
            [
              {
                "text": "{{service_type}} :",
                "border": [true, true, false, false],
                "style": "receipt-table-value"
              },
              {
                "text": "{{serviceType}}",
                "border": [false, true, false, false],
                "style": "receipt-table"
              },
              {
                "text": "{{paid_amount}} :",
                "border": [false, true, false, false],
                "style": "receipt-table-value"
              },
              {
                "text": "₹ {{paidAmount}}",
                "border": [false, true, true, false],
                "style": "receipt-table"
              }
            ],
            [
              {
                "text": "Txn ID / UTR :",
                "border": [true, false, false, true],
                "style": "receipt-table-value"
              },
              {
                "text": "{{transactionID}}",
                "border": [false, false, true, true],
                "style": "receipt-table",
                "font": "Roboto",
                "fontSize": 10,
                "colSpan": 3
              },
              {},
              {}
            ]
          ]
        }
      },

      {
        "style": "noc-mock-table",
        "table": {
          "widths": ["100%"],
          "body": [
            [
              {
                "text": "Detail of Payment",
                "border": [true, true, false, false],
                "style": "receipt-mock-table-value"
              }
            ]
          ]
        },
        "layout": "noBorders"
      },

      {
        "style": "fee-summary-table",
        "table": {
          "widths": ["45%", "55%"],
          "body": [
            [
              {
                "text": "Building Application Fees :",
                "style": "receipt-fee-label",
                "border": [true, true, false, false]
              },
              {
                "text": "₹ {{buildingApplicationFees}}",
                "style": "receipt-fee-value",
                "border": [false, true, true, false]
              }
            ],
            [
              {
                "text": "Boundary Wall Fees :",
                "style": "receipt-fee-label",
                "border": [true, false, false, false]
              },
              {
                "text": "₹ {{boundaryWallFee}}",
                "style": "receipt-fee-value",
                "border": [false, false, true, false]
              }
            ],
            [
              {
                "text": "{{total_amount}} :",
                "style": "receipt-total-label",
                "border": [true, false, false, true],
                "fillColor": "#f2f2f2"
              },
              {
                "text": "₹ {{totalAmount}}",
                "style": "receipt-total-value",
                "border": [false, false, true, true],
                "fillColor": "#f2f2f2"
              }
            ]
          ]
        }
      },

      {
  "style": "receipt-approver",
  "columns": [
    {
      "text": [
        { "text": "{{generated_by}}: ", "bold": true }
      ],
      "alignment": "left"
    },
    {
      "ul": [
        { "text": "{{user-name}}","listType": "none", "margin": [ -90, 0, 0, 0 ] },
        { "text": "{{generator_mobileno}}" ,"listType": "none","margin": [ -90, 0, 0, 0 ]}
      ],
      "alignment": "left"
    },
    {
      "text": [
        { "text": "Municipal Corporation, Amritsar", "bold": true }
      ],
      "alignment": "right",
      "margin": [0, 0, -10, 0]
    }
  ]
},
      {
        "style": "pt-disclaimer",
        "stack": [
          {
            "text": "Disclaimer",
            "bold": true,
            "style": "pt-disclaimer-header"
          },

          {
            "ol": [
              " This receipt is generated electronically by the Building Plan Approval System of the Municipal Corporation Amritsar.",
              " Payment details shown above are based on records available at the time of generation.",
              " In case of any discrepancies, kindly contact the concerned municipal office with a copy of this receipt.",
              " The Corporation shall not be responsible for delays caused due to banking network or technical issues.",
              " Retain this receipt for future reference — it serves as proof of payment."
            ],
            "alignment": "justify",
            "margin": [20, 0, 0, 10]
          }
        ]
      },
      {
        "style": "no-signature",
        "text": "This is a system-generated receipt and does not require a physical signature."
      }
    ],

    "styles": {
      "noc-head": { "margin": [0, -20, 0, 10] },
      "noc-table": {
        "fontSize": 12,
        "color": "#000000",
        "margin": [0, 0, 0, 5]
      },

      "noc-mock-table": {
        "fontSize": 12,
        "color": "#000000",
        "margin": [0, 2, 0, 0]
      },
      "next-noc-table": {
        "fontSize": 12,
        "color": "#000000",
        "margin": [0, 15, 0, 10]
      },
      "receipt-table-value": {
        "color": "#000000",
        "bold": true,
        "fontSize": 12,
        "margin": [2, 4, 0, 4]
      },
      "receipt-mock-table-value": {
        "color": "#000000",
        "bold": true,
        "fontSize": 12,
        "margin": [2, 0, 0, 0]
      },
      "receipt-table": {
        "color": "#000000",
        "bold": false,
        "fontSize": 12,
        "margin": [2, 4, 0, 4]
      },
      "receipt-mock-table": {
        "color": "#000000",
        "bold": false,
        "fontSize": 12,
        "margin": [2, 0, 0, 0]
      },
      "receipt-fee-label": {
        "fontSize": 12,
        "color": "#000000",
        "bold": true,
        "margin": [4, 0, 0, 6]
      },
      "receipt-fee-value": {
        "fontSize": 12,
        "color": "#000000",
        "alignment": "right",
        "margin": [0, 6, 4, 6]
      },
      "receipt-total-label": {
        "fontSize": 12,
        "color": "#000000",
        "bold": true,
        "margin": [4, 6, 0, 6]
      },
      "receipt-total-value": {
        "fontSize": 12,
        "color": "#000000",
        "bold": true,
        "alignment": "right",
        "margin": [0, 6, 4, 6]
      },
      "receipt-approver": {
        "fontSize": 12,
        "bold": true,
        "margin": [0, 5, 0, 2],
        "color": "#484848"
      },
      "no-signature": {
        "fontSize": 12,
        "margin": [0, 5, 0, 5],
        "color": "#484848",
        "alignment": "center"
      },
      "pt-disclaimer": {
        "fontSize": 11,
        "margin": [0, 5, 0, 0],
        "color": "#484848"
      },
      "pt-disclaimer-header": {
        "fontSize": 11,
        "bold": true,
        "margin": [0, 0, 0, 4],
        "color": "#000000"
      },
      "pt-disclaimer-value": {
        "fontSize": 11,
        "margin": [2, 3, 0, 0],
        "color": "#484848",
        "alignment": "justify"
      }
    }
  }
}
