{
  "key": "petcertificatenew",
  "config": {
    "defaultStyle": {
      "font": "Roboto",
      "fontSize": 8
    },
    "content": [
      {
        "style": "noc-head",
        "table": {
          "widths": ["*", "auto", "*"],
          "body": [
            [
              {
                "image": "{{logoImage}}",
                "width": 60,
                "height": 60,
                "alignment": "left"
              },
              {
                "stack": [
                  {
                    "text": "{{ulbType}} {{logo-header}}",
                    "style": "receipt-logo-header",
                    "alignment": "center",
                    "margin": [0, 0, 0, 0]
                  },
                  {
                    "stack": [
                      { "text": "Veterinary Services- Health Branch" },
                      { "text": "Pet Registration Certificate", "bold": true },
                      { "text": "(U/S 399 (1)(E) of PMC Act,1976)" }
                    ],
                    "alignment": "center",
                    "color": "#484848",
                    "margin": [0, 2, 0, 2]
                  }
                ],
                "margin": [20, 0, 0, 0],
                "alignment": "center"
              },
              ""
            ]
          ]
        },
        "layout": "noBorders"
      },
      {
        "stack": [
          {
            "text": "This is to certify that the {{petType}} kept by Mr./Mrs./Ms. {{petOwner}} at {{ownerAddress}}, {{ownerpincode}} mobile no. {{payerContact}} is registered with {{ulbType}} {{logo-header}} as per following details:",
            "alignment": "center",
            "margin": [0, 5, 0, 2]
          },
          {
            "text": "Pet Information",
            "margin": [0, 2, 0, 2],
            "bold": true
          },
          {
            "text": "Registration Number: {{petRegistrationNumber}}",
            "margin": [0, 0, 0, 0],
            "bold": true
          }
        ]
      },
      {
        "columns": [
          {
            "width": "*",
            "style": "noc-table",
            "table": {
              "widths": ["auto", "auto", "auto", "auto"],
              "body": [
                [
                  {
                    "text": "Category",
                    "border": [true, true, false, true],
                    "style": "receipt-table-value"
                  },
                  {
                    "text": "{{petType}}",
                    "border": [true, true, true, true],
                    "style": "receipt-table",
                    "fontSize": 8
                  },
                  {
                    "text": "Breed",
                    "border": [true, true, false, true],
                    "style": "receipt-table-value"
                  },
                  {
                    "text": "{{breedType}}",
                    "border": [true, true, true, true],
                    "style": "receipt-table-value"
                  }
                ],
                [
                  {
                    "text": "Name of Animal",
                    "border": [true, true, false, true],
                    "style": "receipt-table-value"
                  },
                  {
                    "text": "{{petName}}",
                    "border": [true, true, true, true],
                    "style": "receipt-table"
                  },
                  {
                    "text": "Gender",
                    "border": [true, true, false, true],
                    "style": "receipt-table-value"
                  },
                  {
                    "text": "{{petGender}}",
                    "border": [true, true, true, true],
                    "style": "receipt-table-value"
                  }
                ],
                [
                  {
                    "text": "Pet Age",
                    "border": [true, true, false, true],
                    "style": "receipt-table-value"
                  },
                  {
                    "text": "{{petAge}}",
                    "border": [true, true, true, true],
                    "style": "receipt-table-value"
                  },
                  {
                    "text": "Colour",
                    "border": [true, true, false, true],
                    "style": "receipt-table-value"
                  },
                  {
                    "text": "{{petColor}}",
                    "border": [true, true, true, true],
                    "style": "receipt-table",
                    "fontSize": 8
                  }
                ],
                [
                  {
                    "text": "Application Number",
                    "border": [true, true, false, true],
                    "style": "receipt-table-value"
                  },
                  {
                    "text": "{{consumerID}}",
                    "border": [true, true, true, true],
                    "style": "receipt-table-value"
                  },
                  {
                    "text": "Token No.",
                    "border": [true, true, false, true],
                    "style": "receipt-table-value"
                  },
                  {
                    "text": "{{petToken}}",
                    "border": [true, true, true, true],
                    "style": "receipt-table",
                    "fontSize": 8
                  }
                ],
                [
                  {
                    "text": "Issue Date",
                    "border": [true, true, false, true],
                    "style": "receipt-table-value"
                  },
                  {
                    "text": "{{issueDate}}",
                    "border": [true, true, true, true],
                    "style": "receipt-table-value"
                  },
                  {
                    "text": "License Valid Upto",
                    "border": [true, true, false, true],
                    "style": "receipt-table-value"
                  },
                  {
                    "text": "{{validityDate}}",
                    "border": [true, true, true, true],
                    "style": "receipt-table",
                    "fontSize": 8
                  }
                ],
                [
                  {
                    "text": "Amount",
                    "border": [true, true, false, true],
                    "style": "receipt-table-value"
                  },
                  {
                    "text": "{{totalAmount}}",
                    "border": [true, true, true, true],
                    "style": "receipt-table-value"
                  },
                  {
                    "text": "G8/Receipt No",
                    "border": [true, true, false, true],
                    "style": "receipt-table-value"
                  },
                  {
                    "text": "{{receiptNo}}",
                    "border": [true, true, true, true],
                    "style": "receipt-table-value"
                  }
                ]
              ]
            }
          },
          {
            "width": "auto",
            "stack": [
              {
                "image": "{{fileUrl}}",
                "fit": [90, 90],
                "alignment": "center"
              },
              {
                "text": "Pet Photo",
                "bold":true,
                "alignment": "center"
              }
            ],
            "margin": [10, 0, 0, 0]
          }
        ],
        "margin": [20, 0, 0, 0]
      },

      {
        "text": "Owner Information",
        "bold": true,
        "style": "receipt-table-value",
        "margin": [0, 10, 0, 5]
      },
      {
        "style": "next-noc-table",
        "table": {
          "widths": ["25%", "25%"],
          "body": [
            [
              {
                "text": "Owner Name",
                "border": [true, true, false, false],
                "style": "receipt-table-value"
              },
              {
                "text": "{{petOwner}}",
                "border": [false, true, true, false],
                "style": "receipt-table"
              }
            ],
            [
              {
                "text": "Father/Spouse Name",
                "border": [true, false, false, false],
                "style": "receipt-table-value"
              },
              {
                "text": "{{fatherOrHusbandName}}",
                "border": [false, false, true, false],
                "style": "receipt-table"
              }
            ],
            [
              {
                "text": "Address",
                "border": [true, false, false, true],
                "style": "receipt-table-value"
              },
              {
                "text": "{{ownerAddress}}, {{ownerpincode}}",
                "border": [false, false, true, true],
                "style": "receipt-table"
              }
            ]
          ]
        },
        "margin": [-2, -4, 0, 0],
        "layout": {}
      },

      {
        "stack": [
          {
            "text": "DISCLAIMER",
            "style": "receipt-logo-header",
            "alignment": "center",
            "margin": [0, 2, 0, 0]
          },
          {
            "text": "The registration is purely on the basis of self certification. If any of the statements of undertaking/self declaration are found otherwise subsequently, the registration is liable to be cancelled/revoked for all intents and purposes forthwith and such person shall be liable for legal and penal action for obtaining registration fraudulently by making false averments.",
            "style": "receipt-logo-sub-header",
            "alignment": "center",
            "margin": [0, 2, 0, 0]
          }
        ],
        "alignment": "center"
      },
      {
        "style": "receipt-approver",
        "columns": [
          {
            "stack": [
              {
                "text": "Date: {{issueDate}} ",
                "bold": true
              },
              {
                "text": "Place: {{logo-header}}",
                "bold": false
              }
            ],
            "alignment": "left"
          },
          {
            "stack": [
              {
                "text": "Approved By",
                "bold": true
              },
              {
                "text": "{{approver}}",
                "bold": false
              },
              {
                "text": "---------------------",
                "bold": false
              },
              {
                "text": "Licensing Authority",
                "bold": false
              },
              {
                "text": "{{ulbType}}",
                "bold": false
              }
            ],
            "alignment": "right"
          }
        ]
      },
      {
        "canvas": [
          {
            "type": "line",
            "x1": -40,
            "y1": 0,
            "x2": 555,
            "y2": 0,
            "lineColor": "#000000",
            "lineWidth": 2
          }
        ],
        "margin": [0, 5, 0, 10]
      },
      {
        "style": "next-noc-table",
        "table": {
          "widths": ["100%"],
          "body": [
            [
              {
                "text": "TERMS AND CONDITIONS",
                "bold": true,
                "style": "receipt-table-value-down",
                "alignment": "left",
                "border": [false, false, false, false],
                "margin": [0, 0, 0, 0]
              }
            ],
            [
              {
                "ol": [
                  {
                    "text": [
                      "{{pet_term_1a}}",
                      { "text": " {{pet_registration_number}} ", "bold": true },
                      "{{pet_term_1b}} ",
                      {
                        "text": "'https://mseva.lgpunjab.gov.in/digit-ui/citizen/ptr-home'",
                        "bold": true,
                        "link": "https://mseva.lgpunjab.gov.in/digit-ui/citizen/ptr-home"
                      }
                    ]
                  },
                  "{{pet_new_term_2}}",
                  "{{pet_new_term_3}}",
                  "{{pet_new_term_4}}",
                  "{{pet_new_term_5}}",
                  "{{pet_new_term_6}}",
                  "{{pet_new_term_7}}",
                  "{{pet_new_term_8}}",
                  "{{pet_new_term_9}}",
                  "{{pet_new_term_10}}",
                  "{{pet_new_term_11}}",
                  "{{pet_new_term_12}}",
                  "{{pet_new_term_13}}",
                  "{{pet_new_term_14}}",
                  "{{pet_new_term_15}}",
                  "{{pet_new_term_16}}"
                ],
                "style": "receipt-table",
                "fontSize": 7,
                "alignment": "justify",
                "border": [false, false, false, false],
                "margin": [0, 0, 0, 0]
              }
            ]
          ]
        },
        "layout": "noBorders"
      },
      {
        "style": "next-noc-table",
        "table": {
          "widths": ["*", "auto", "*"],
          "body": [
            [
              {
                "text": " "
              },
              {
                "image": "{{qrcodeimage}}",
                "width": 60,
                "height": 60
              },
              {
                "text": " "
              }
            ]
          ]
        },
        "layout": "noBorders"
      }
    ],
    "styles": {
      "noc-head": {
        "margin": [-30, -30, 0, 1]
      },
      "receipt-logo-header": {
        "color": "#000000",
        "fontSize": 14,
        "bold": true,
        "letterSpacing": 0.74,
        "margin": [0, 0, 0, 2]
      },
      "receipt-logo-sub-header": {
        "color": "#000000",
        "fontSize": 8,
        "letterSpacing": 0.6
      },
      "noc-table": {
        "fontSize": 8,
        "color": "#000000",
        "margin": [-25, 2, -22, -8]
      },
      "receipt-table-value-total-Qr": {
        "alignment": "right",
        "margin": [0, 3, 10, 0]
      },
      "receipt-table-value-down": {
        "color": "#000000",
        "bold": false,
        "fontSize": 8,
        "fontWeight": 400,
        "alignment": "left",
        "margin": [3, 0, 0, 0]
      },
      "next-noc-table": {
        "fontSize": 8,
        "color": "#000000",
        "margin": [-25, 10, -22, -8]
      },
      "receipt-table-value": {
        "color": "#000000",
        "bold": true,
        "fontSize": 8,
        "fontWeight": 500,
        "margin": [0, 0, 0, 0]
      },
      "receipt-table": {
        "color": "#000000",
        "bold": false,
        "fontSize": 8,
        "fontWeight": 400,
        "margin": [0, 0, 0, 0]
      },
      "receipt-approver": {
        "fontSize": 8,
        "bold": true,
        "margin": [-27, 0, -10, 0],
        "color": "#484848"
      },
      "no-signature": {
        "fontSize": 8,
        "margin": [-27, 35, -10, 0],
        "color": "#484848"
      },
      "pt-disclaimer": {
        "fontSize": 8,
        "margin": [-27, 5, -10, 0],
        "color": "#484848"
      },
      "pt-disclaimer-value": {
        "fontSize": 8,
        "margin": [2, 3, 0, 0],
        "color": "#484848"
      }
    }
  }
}
