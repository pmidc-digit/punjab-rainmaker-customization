{
  "key": "wsn-integrated",
  "config": {
    "defaultStyle": {
      "font": "Cambay",
      "fontSize": 9
    },

    "pageMargins": [30, 30, 30, 30],

    "content": [

      {
        "table": {
          "widths": [60, "*", 120],
          "body": [
            [
              { "image": "{{logoImage}}", "width": 45 },
              {
                "stack": [
                  { "text": "{{logo_header}} {{mcGrade}}", "style": "header-title" },
                  { "text": "{{address}}", "style": "header-sub" },
                  { "text": "{{website}}  |  {{email}}", "style": "header-sub" }
                ],
                "alignment": "center"
              },
              {
                "stack": [
                  { "text": "TOTAL AMOUNT DUE", "style": "amount-label" },
                  { "text": "₹ {{totalAmountDue}}", "style": "amount-value" }
                ],
                "alignment": "right"
              }
            ]
          ]
        },
        "layout": "noBorders"
      },

      { "canvas": [{ "type": "line", "x1": 0, "y1": 5, "x2": 515, "y2": 5 }] },

      { "text": "PROPERTY & OWNER DETAILS", "style": "section-header" },

      {
        "table": {
          "widths": ["25%", "25%", "25%", "25%"],
          "body": [
            ["Property Id", "Ledger / Group", "Plot Size", "Usage Type"],
            ["{{propertyId}}", "{{landmark}}", "{{plotSize}}", "{{usageType}}"],
            ["Owner Name", "Guardian Name", "Mobile No", "Locality"],
            ["{{ownerName}}", "{{guardianName}}", "{{mobileNo}}", "{{locality}}"]
          ]
        },
        "style": "data-table"
      },

      { "text": "CONSUMER DETAILS", "style": "section-header" },

      {
        "table": {
          "widths": ["25%", "25%", "25%", "25%"],
          "body": [
            ["Water Consumer", "{{wsconsumerCode}}", "Sewerage Consumer", "{{swconsumerCode}}"],
            ["Water Old Consumer", "{{wsoldconsumerCode}}", "Sewerage Old Consumer", "{{swoldconsumerCode}}"],
            ["Water Payer", "{{wspayerName}}", "Sewerage Payer", "{{swpayerName}}"],
            ["Water Bill Date", "{{wsbillDate}}", "Sewerage Bill Date", "{{swbillDate}}"]
          ]
        },
        "style": "data-table"
      },

      { "text": "METER DETAILS", "style": "section-header" },

      {
        "table": {
          "widths": ["20%", "20%", "20%", "20%", "20%"],
          "body": [
            ["Last Reading", "Last Date", "Current Reading", "Current Date", "Units (KL)"],
            ["{{lastReading}}", "{{lastReadingDate}}", "{{currentReading}}", "{{currentReadingDate}}", "{{units}}"]
          ]
        },
        "style": "data-table"
      },

      { "text": "WATER BILL SUMMARY", "style": "section-header" },

      {
        "table": {
          "widths": ["40%", "30%", "30%"],
          "body": [
            ["Bill No", "From", "To"],
            ["{{wsbillNumber}}", "{{wsfromPeriod}}", "{{wstoPeriod}}"]
          ]
        },
        "style": "data-table"
      },
      {
        "table": {
          "widths": ["20%", "10%", "10%", "10%", "10%", "10%", "10%", "20%"],
          "body": [
            ["{{charge_label}}", "{{arrears_label}}", "{{penalty_label}}", "{{intrest_label}}", "{{advance_label}}", "{{others_label}}", "{{rebate_label}}" , "{{total_label}}"],
            [ "{{wscharge}}", "{{wsarrears}}", "{{wspenalty}}", "{{wsinterest}}", "{{wsadvance}}","{{wsothers}}", "{{wsrebate}}", "{{wschargestotalAmount}}"]
          ]
        },
        "style": "data-table-bill"
      },

      { "text": "SEWERAGE BILL SUMMARY", "style": "section-header" },

      {
        "table": {
          "widths": ["40%", "30%", "30%"],
          "body": [
            ["Bill No", "From", "To"],
            ["{{swbillNumber}}", "{{swfromPeriod}}", "{{swtoPeriod}}"]
          ]
        },
        "style": "data-table"
      },
      {
        "table": {
          "widths": ["20%", "10%", "10%", "10%", "10%", "10%", "10%", "20%"],
          "body": [
            ["{{charge_label}}", "{{arrears_label}}", "{{penalty_label}}", "{{intrest_label}}", "{{advance_label}}", "{{others_label}}", "{{rebate_label}}" , "{{total_label}}"],
            [ "{{swcharge}}", "{{swarrears}}", "{{swpenalty}}", "{{swinterest}}", "{{swadvance}}","{{swothers}}", "{{swrebate}}", "{{swchargestotalAmount}}"]
          ]
        },
        "style": "data-table-bill"
      },
      { "text": "IMPORTANT INSTRUCTIONS", "style": "section-header" },

      {
        "ul": [
          "Online payment available at https://mseva.lgpunjab.gov.in/citizen",
          "Pay before due date to avoid penalty.",
          "Office collection timing: 9:00 AM to 1:30 PM"
        ],
        "style": "instruction-box"
      },

      { "canvas": [{ "type": "line", "x1": 0, "y1": 10, "x2": 515, "y2": 10, "dash": { "length": 6 } }] },

      { "text": "ACKNOWLEDGEMENT SLIP", "style": "footer-header" },

      {
        "table": {
          "widths": ["25%", "25%", "25%", "25%"],
          "body": [
            ["Consumer No", "{{consumerNo}}", "Bill No", "{{billNo}}"],
            ["Name", "{{payerName}}", "Amount Paid", "{{paidAmount}}"]
          ]
        },
        "style": "data-table"
      },

      { "text": "Signature of Receiver", "style": "footer-bottom" }
    ],

    "styles": {
      "header-title": { "fontSize": 13, "bold": true, "alignment": "center" },
      "header-sub": { "fontSize": 9, "alignment": "center" },

      "amount-label": { "fontSize": 9, "bold": true },
      "amount-value": { "fontSize": 18, "bold": true },

      "section-header": {
        "fontSize": 10,
        "bold": true,
        "fillColor": "#f2f2f2",
        "margin": [0, 5, 0, 6]
      },

      "data-table": {
        "margin": [0, 2, 0, 8]
      },
      "data-table-bill" :{

      },
      "instruction-box": {
        "fontSize": 9,
        "margin": [0, 4, 0, 8]
      },

      "footer-header": {
        "fontSize": 11,
        "bold": true,
        "alignment": "center",
        "margin": [0, 12, 0, 6]
      },

      "footer-bottom": {
        "alignment": "right",
        "margin": [0, 10, 0, 0]
      }
    }
  }
}
