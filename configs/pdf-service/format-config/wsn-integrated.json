{
  "key": "wsn-integrated",
  "config": {
    "defaultStyle": {
      "font": "Cambay"
    },
    "content": [
       {
        "style": "noc-head",
        "table": {
          "widths": [
            60,
            "*",
            120
          ],
          "body": [
            [
              {
                "image": "{{logoImage}}",
                "width": 45,
                "height": 50
              },
              {
                "stack": [
                  {
                    "text": "{{logo_header}} {{mcGrade}}",
                    "style": "receipt-logo-header"
                  },
                  {
                    "stack": [
                      {
                        "text": "{{address}}",
                        "style": "receipt-logo-sub-header"
                      },
                      {
                        "text": "{{website}} {{email}}",
                        "style": "receipt-logo-sub-header"
                      }
                    ]
                  }
                ],
                "alignment": "center",
                "margin": [
                  0,
                  1,
                  0,
                  0
                ]
              },
              {
                "stack": [
                  {
                    "text": "{{total_amount_due}} {{testing billWS}}"
                  },
                  {
                    "text": "{{Rs}} {{totalAmountDue}}",
                    "style": "amount-due"
                  }
                ],
                "alignment": "right",
                "color": "#484848",
                "margin": [
                  -150,
                  1,
                  -20,
                  0
                ]
              }
            ]
          ]
        },
        "layout": "noBorders"
      },

      
      {
        "style": "noc-table2",
        "table": {
          "widths": ["100%"],
          "body": [
            [
              {
                "table": {
                  "widths": ["25%", "25%", "25%", "25%"],
                  "body": [
                    [
                      { "text": "Property Id", "style": "receipt-table-value2" },
                      { "text": "Ledger No/ Group No", "style": "receipt-table2" },
                      { "text": "Plot Size", "style": "receipt-table-value2" },
                      { "text": "Ussage Type", "style": "receipt-table2" }
                    ],
                    [
                      { "text": "{{propertyId}}", "style": "receipt-table-value2" },
                      { "text": "{{}}", "style": "receipt-table2" },
                      { "text": "{{plotSize}}", "style": "receipt-table-value2" },
                      { "text": "{{usageType}}", "style": "receipt-table2" }
                    ],
                    [
                      { "text": "Payer Name", "style": "receipt-table-value2" },
                      { "text": "Guardian Name", "style": "receipt-table2" },
                      { "text": "Mobile Number", "style": "receipt-table-value2" },
                      { "text": "Locality", "style": "receipt-table-value2" }
                    ],
                    [
                      { "text": "{{}}", "style": "receipt-table-value2" },
                      { "text": "{{}}", "style": "receipt-table2" },
                      { "text": "{{mobileNo}}", "style": "receipt-table-value2" },
                      { "text": "{{locality}}", "style": "receipt-table-value2" }
                    ]
                  ]
                }
              }
            ]
          ]
        }
      },
      {
        "style": "noc-table2",
        "table": {
          "widths": ["100%"],
          "body": [
            [
              {
                "table": {
                  "widths": ["25%", "25%", "25%", "25%"],
                  "body": [
                    [
                      { "text": "Water Consumer No", "style": "receipt-table-value2" },
                      { "text": "{{wsconsumerno}}", "style": "receipt-table2" },
                      { "text": "Sewerage Consumer No", "style": "receipt-table-value2" },
                      { "text": "{{swconsumerno}}", "style": "receipt-table2" }
                    ],
                    [
                      { "text": "Water Bill No", "style": "receipt-table-value2" },
                      { "text": "{{wsbillno}}", "style": "receipt-table2" },
                      { "text": "Sewerage Bill No", "style": "receipt-table-value2" },
                      { "text": "{{swbillno}}", "style": "receipt-table2" }
                    ],
                    [
                      { "text": "Water Bill Date", "style": "receipt-table-value2" },
                      { "text": "{{wsbilldate}}", "style": "receipt-table2" },
                      { "text": "Sewerage Bill Date", "style": "receipt-table-value2" },
                      { "text": "{{wsbilldate}}", "style": "receipt-table2" }
                    ]
                  ]
                }
              }
            ]
          ]
        }
      },

      {
        "style": "noc-table2",
        "table": {
          "widths": ["100%"],
          "body": [
            [
              { "text": "METER DETAILS", "style": "receipt-table-value" }
            ],
            [
              {
                "table": {
                  "widths": ["20%", "20%", "20%", "20%", "20%"],
                  "body": [
                    [
                      { "text": "Last Reading", "style": "receipt-table-value2" },
                      { "text": "Last Reading Date", "style": "receipt-table-value2" },
                      { "text": "Current Reading", "style": "receipt-table-value2" },
                      { "text": "Current Reading Date", "style": "receipt-table-value2" },
                      { "text": "Units (KL)", "style": "receipt-table-value2" }
                    ],
                    [
                      { "text": "{{lastReading}}", "style": "receipt-table2" },
                      { "text": "{{lastReadingDate}}", "style": "receipt-table2" },
                      { "text": "{{currentReading}}", "style": "receipt-table2" },
                      { "text": "{{currentReadingDate}}", "style": "receipt-table2" },
                      { "text": "{{units}}", "style": "receipt-table2" }
                    ]
                  ]
                }
              }
            ]
          ]
        }
      },

      {
        "style": "noc-table2",
        "table": {
          "widths": ["100%"],
          "body": [
            [
              { "text": "Water BILL SUMMARY", "style": "receipt-table-value" }
            ],
            [
              {
                "table": {
                  "widths": ["16%", "16%", "16%", "16%", "16%", "20%"],
                  "body": [
                    [
                      { "text": "Bill From ", "colspan" : "2", "style": "receipt-table-value2" },
                      { "text": "{{wsfromPeriod}}", "style": "receipt-table-value2" },
                      { "text": "Bill To", "colspan" : "2", "style": "receipt-table-value2" },
                      { "text": "{{wstoPeriod}}", "style": "receipt-table-value2" }
                    ],
                    [
                      { "text": "Water Charges", "style": "receipt-table-value2" },
                      { "text": "Arrears", "style": "receipt-table-value2" },
                      { "text": "Penalty", "style": "receipt-table-value2" },
                      { "text": "Intrest", "style": "receipt-table-value2" },
                      { "text": "Advance", "style": "receipt-table-value2" },
                      { "text": "Total", "style": "receipt-table-value2" }
                    ],
                    [
                      { "text": "{{wscharge}}", "style": "receipt-table2" },
                      { "text": "{{wsarrears}}", "style": "receipt-table2" },
                      { "text": "{{wspenalty}}", "style": "receipt-table2" },
                      { "text": "{{wsinterest}}", "style": "receipt-table2" },
                       { "text": "{{wsadvance}}", "style": "receipt-table2" },
                      { "text": "{{wschargestotalAmount}}", "style": "receipt-table2", "bold": true }
                    ]
                  ]
                }
              }
            ]
          ]
        }
      },
      {
        "style": "noc-table2",
        "table": {
          "widths": ["100%"],
          "body": [
            [
              { "text": "Sewerage BILL SUMMARY", "style": "receipt-table-value" }
            ],
            [
              {
                "table": {
                  "widths": ["16%", "16%", "16%", "16%", "16%", "20%"],
                  "body": [
                     [
                      { "text": "Bill From ", "colspan" : "2", "style": "receipt-table-value2" },
                      { "text": "{{swfromPeriod}}", "style": "receipt-table-value2" },
                      { "text": "Bill To", "colspan" : "2", "style": "receipt-table-value2" },
                      { "text": "{{swtoPeriod}}", "style": "receipt-table-value2" }
                    ],
                    [
                      { "text": "Sewerage Charges", "style": "receipt-table-value2" },
                      { "text": "Arrears", "style": "receipt-table-value2" },
                      { "text": "Penalty", "style": "receipt-table-value2" },
                      { "text": "Intrest", "style": "receipt-table-value2" },
                      { "text": "Advance", "style": "receipt-table-value2" },
                      { "text": "Total", "style": "receipt-table-value2" }
                    ],
                    [
                     { "text": "{{swcharge}}", "style": "receipt-table2" },
                      { "text": "{{swarrears}}", "style": "receipt-table2" },
                      { "text": "{{swpenalty}}", "style": "receipt-table2" },
                      { "text": "{{swinterest}}", "style": "receipt-table2" },
                       { "text": "{{swadvance}}", "style": "receipt-table2" },
                      { "text": "{{swchargestotalAmount}}", "style": "receipt-table2", "bold": true }
                    ]
                  ]
                }
              }
            ]
          ]
        }
      },

      {
        "style": "noc-table3",
        "table": {
          "widths": ["100%"],
          "body": [
            [
              { "text": "IMPORTANT INSTRUCTIONS", "style": "receipt-table-value" }
            ],
            [
              { "text": "1. Online payment available at https://mseva.lgpunjab.gov.in/citizen" }
            ],
            [
              { "text": "2. Pay before due date to avoid penalty." }
            ],
            [
              { "text": "3. Office collection timing: 9:00 AM to 1:30 PM" }
            ]
          ]
        }
      },

      {
        "canvas": [
          {
            "type": "line",
            "x1": -40,
            "y1": 28,
            "x2": 700,
            "y2": 28,
            "dash": { "length": 10, "space": 5 }
          }
        ]
      },

      { "text": "Authorized Signatory", "style": "footer-bottom" },

      { "text": "ACKNOWLEDGEMENT SLIP", "style": "footer-header" },

      {
        "style": "noc-table4",
        "table": {
          "widths": ["25%", "25%", "25%", "25%"],
          "body": [
            [
              { "text": "Consumer No", "style": "receipt-table-value" },
              { "text": "{{consumerNo}}", "style": "receipt-table" },
              { "text": "Bill No", "style": "receipt-table-value" },
              { "text": "{{billNo}}", "style": "receipt-table" }
            ],
            [
              { "text": "Name", "style": "receipt-table-value" },
              { "text": "{{payerName}}", "style": "receipt-table" },
              { "text": "Amount Paid", "style": "receipt-table-value" },
              { "text": "{{paidAmount}}", "style": "receipt-table" }
            ]
          ]
        }
      },

      { "text": "Signature of Receiver", "style": "footer-bottom" }
    ],

    "styles": {
      "noc-head": { "margin": [-25, -30, 0, 1] },
      "receipt-logo-header": { "fontSize": 12, "bold": true },
      "receipt-logo-sub-header": { "fontSize": 10 },
      "noc-table2": { "fontSize": 10, "margin": [-25, 8, -8, -8] },
      "noc-table3": { "fontSize": 8, "margin": [-25, 10, -8, -8] },
      "noc-table4": { "fontSize": 10, "margin": [-25, 40, -8, -8] },
      "receipt-table-value": { "bold": true, "fontSize": 10 },
      "receipt-table-value2": { "bold": true, "fontSize": 10 },
      "receipt-table": { "fontSize": 10 },
      "receipt-table2": { "fontSize": 10 },
      "footer-header": { "bold": true, "alignment": "center" },
      "footer-bottom": { "bold": true, "alignment": "right" },
      "amount-due": { "fontSize": 20, "bold": true }
    }
  }
}
