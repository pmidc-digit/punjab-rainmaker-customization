{
  "key": "rentandlease-receipt",
  "config": {
    "defaultStyle": {
      "font": "Roboto"
    },
    "content": [
      {
        "style": "noc-head",
        "table": {
          "widths": [90, "*", 90],
          "body": [
            [
              {
                "image": "{{logoImage}}",
                "width": 70,
                "height": 70,
                "alignment": "left"
              },
              {
                "stack": [
                  {
                    "text": "{{ulbType}} {{logo-header}}",
                    "style": "receipt-logo-header",
                    "alignment": "center",
                    "margin": [0, 5, 0, 5]
                  },
                  {
                    "stack": [
                      { "text": "{{address}}" },
                      { "text": "{{phoneNumber}}" },
                      { "text": "{{website}}" },
                      { "text": "{{email}}" }
                    ],
                    "alignment": "center",
                    "color": "#484848",
                    "margin": [0, 2, 0, 2]
                  },
                  {
                    "text": "Rent and Lease {{payment_receipt}}",
                    "style": "receipt-logo-sub-header",
                    "alignment": "center",
                    "margin": [0, 5, 0, 0]
                  }
                ],
                "alignment": "center"
              },
              {
                "image": "{{qrcodeimage}}",
                "width": 72,
                "height": 72,
                "alignment": "right",
                "margin": [0, 0, 0, 0]
              }
            ]
          ]
        },
        "layout": "noBorders"
      },
      {
        "style": "noc-table",
        "table": {
          "widths": ["26%", "21%", "27%", "26%"],
          "body": [
            [
              {
                "text": "{{receipt_no}}.",
                "border": [true, true, false, false],
                "style": "receipt-table-value"
              },
              {
                "text": "{{receiptNo}}",
                "border": [false, true, false, false],
                "style": "receipt-table",
                "font": "Roboto",
                "fontSize": 10
              },
              {
                "text": "Application Number",
                "border": [false, true, false, false],
                "style": "receipt-table-value"
              },
              {
                "text": "{{consumerID}}",
                "border": [false, true, true, false],
                "style": "receipt-table",
                "font": "Roboto",
                "fontSize": 10
              }
            ],
            [
              {
                "text": "{{payment_date}}",
                "border": [true, false, false, false],
                "style": "receipt-table-value"
              },
              {
                "text": "{{paymentDate}}",
                "border": [false, false, false, false],
                "style": "receipt-table"
              },
              {
                "text": "Applicant Name",
                "border": [false, false, false, false],
                "style": "receipt-table-value"
              },
              {
                "text": "{{payerName}}",
                "border": [false, false, true, false],
                "style": "receipt-table"
              }
            ],
            [
              {
                "text": "Applicant Contact",
                "border": [true, false, false, true],
                "style": "receipt-table-value"
              },
              {
                "text": "{{payerContact}}",
                "border": [false, false, false, true],
                "style": "receipt-table"
              },
              {
                "text": "Billing Number ",
                "border": [false, false, false, true],
                "style": "receipt-table-value"
              },
              {
                "text": "{{billingContact}}",
                "border": [false, false, true, true],
                "style": "receipt-table"
              }
            ]
          ]
        },
        "layout": {}
      },
      {
        "style": "next-noc-table",
        "table": {
          "widths": ["27%", "26%", "22%", "25%"],
          "body": [
            [
              {
                "text": "{{service_type}}",
                "border": [true, true, false, false],
                "style": "receipt-table-value"
              },
              {
                "text": "Rent and Lease Services",
                "border": [false, true, false, false],
                "style": "receipt-table"
              },
              {
                "text": "{{validityPeriodvariable}}",
                "border": [false, true, false, false],
                "style": "receipt-table-value"
              },
              {
                "text": "{{validityPeriod}}",
                "border": [false, true, true, false],
                "style": "receipt-table"
              }
            ],
            [
              {
                "text": "{{paid_amount}}",
                "border": [true, false, false, false],
                "style": "receipt-table-value"
              },
              {
                "text": "₹ {{paidAmount}}",
                "border": [false, false, false, false],
                "style": "receipt-table"
              },
              {
                "text": "{{payment_mode}}",
                "border": [false, false, false, false],
                "style": "receipt-table-value"
              },
              {
                "text": "{{paymentMode}}",
                "border": [false, false, true, false],
                "style": "receipt-table"
              }
            ],
            [
              {
                "text": "{{transaction_id}}",
                "border": [true, false, false, true],
                "style": "receipt-table-value"
              },
              {
                "text": "{{transactionID}}",
                "border": [false, false, false, true],
                "style": "receipt-table"
              },
              {
                "text": " ",
                "border": [false, false, false, true],
                "style": "receipt-table-value"
              },
              {
                "text": " ",
                "border": [false, false, true, true],
                "style": "receipt-table",
                "font": "Roboto",
                "fontSize": 10
              }
            ]
          ]
        },
        "layout": {}
      },
      {
        "style": "next-noc-table",
        "table": {
          "widths": ["100%"],
          "body": [
            [
              {
                "table": {
                  "widths": ["*", "*"],
                  "body": "[{{#var_billDetails}}[{\"text\":\"{{billTaxHeadCode}}\",\"alignment\":\"left\",\"border\":[true,true,false,true], \"style\":\"receipt-table2\"},{\"text\":\"{{billAmount}}\",\"alignment\":\"left\",\"style\":\"receipt-table2\",\"border\":[false,true,true,true]}]{{/var_billDetails}}]"
                },
                "border": [true, true, true, true]
              }
            ],
            [
              {
                "table": {
                  "widths": ["*", "*"],
                  "body": [
                    [
                      {
                        "text": "Total Amount:",
                        "border": [false, false, false, false],
                        "style": "receipt-table-value"
                      },
                      {
                        "text": "{{totalAmount}}",
                        "border": [false, false, false, false],
                        "style": "receipt-table-value",
                        "margin-left": 3,
                        "bold":false,
                        "font": "Roboto"
                      }
                    ]
                  ]
                },
                "border": [true, true, true, true]
              }
            ]
          ]
        },
        "layout": {}
      },
      {
        "style": "receipt-approver",
        "columns": [
          {
            "text": [
              {
                "text": "{{generated_by}}: ",
                "bold": true
              },
              {
                "text": "{{user-name}}",
                "bold": false
              }
            ],
            "alignment": "left"
          }
        ]
      },
      {
        "style": "pt-disclaimer",
        "stack": [
          {
            "text": "Disclaimer",
            "bold": true,
            "style": "pt-disclaimer-header"
          },

          {
            "ol": [
              " The Payment received by cheque/DD shall be subject to realization.",
              " The responsibility of verification of this document before accepting the same for any legal purpose would rest with the institution/organization or any entity where the document is produced.",
              " In case of discrepancy please inform the issuing authority."
            ],
            "alignment": "justify",
            "margin": [10, 0, 0, 0]
          }
        ]
      },
      {
        "style": "no-signature",
        "text": "{{no_signature}}",
        "alignment": "center"
      }
    ],
    "styles": {
      "noc-head": {
        "margin": [-30, -30, 0, 1]
      },
      "receipt-logo-header": {
        "color": "#000000",
        "fontSize": 14,
        "bold": true,
        "letterSpacing": 0.74,
        "margin": [0, 0, 0, 5]
      },
      "receipt-logo-sub-header": {
        "color": "#000000",
        "fontSize": 12,
        "letterSpacing": 0.6
      },
      "noc-table": {
        "fontSize": 12,
        "color": "#000000",
        "margin": [-25, 10, -22, -8]
      },
      "receipt-table-value-total-Qr": {
        "alignment": "right",
        "margin": [0, 3, 10, 0]
      },
      "receipt-table-value-down": {
        "color": "#000000",
        "bold": false,
        "fontSize": 12,
        "fontWeight": 400,
        "alignment": "left",
        "margin": [3, 5, 0, 5]
      },
      "next-noc-table": {
        "fontSize": 12,
        "color": "#000000",
        "margin": [-25, 28, -22, -8]
      },
      "receipt-table-value": {
        "color": "#000000",
        "bold": true,
        "fontSize": 12,
        "fontWeight": 500,
        "margin": [-2, 2, 0, 2]
      },
      "receipt-table": {
        "color": "#000000",
        "bold": false,
        "fontSize": 12,
        "fontWeight": 400,
        "margin": [-30, 2, 0, 2]
      },
      "receipt-approver": {
        "fontSize": 12,
        "bold": true,
        "margin": [-27, 50, -10, 0],
        "color": "#484848"
      },
      "no-signature": {
        "fontSize": 12,
        "margin": [-27, 35, -10, 0],
        "color": "#484848"
      },
      "pt-disclaimer": {
        "fontSize": 12,
        "margin": [-27, 30, -10, 0],
        "color": "#484848"
      },
      "pt-disclaimer-value": {
        "fontSize": 12,
        "margin": [2, 3, 0, 0],
        "color": "#484848"
      }
    }
  }
}
