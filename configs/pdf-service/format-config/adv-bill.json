{
  "key": "adv-bill",
  "config": {
    "defaultStyle": {
      "font": "Cambay"
    },
    "content": [
      {
        "style": "noc-head",
        "table": {
          "widths": [90, "*", 90],
          "body": [
            [
              {
                "image": "{{logoImage}}",
                "width": 60,
                "height": 60,
                "alignment": "left"
              },
              {
                "stack": [
                  {
                    "text": "{{logo-header}} {{Municipal_Corporation}}",
                    "style": "receipt-logo-header",
                    "alignment": "center",
                    "margin": [0, 5, 0, 5]
                  },
                  {
                    "stack": [
                      { "text": "{{address}}" },
                      { "text": "{{phoneNumber}}" },
                      { "text": "{{website}}" },
                      { "text": "{{email}}" }
                    ],
                    "alignment": "center",
                    "color": "#484848",
                    "margin": [0, 2, 0, 2]
                  },
                  {
                    "text": "{{serviceType}} {{payment_receipt}}",
                    "style": "receipt-logo-sub-header",
                    "alignment": "center",
                    "margin": [0, 5, 0, 0]
                  }
                ],
                "alignment": "center"
              },
              {
                "image": "{{qrcodeimage}}",
                "width": 72,
                "height": 72,
                "alignment": "right",
                "margin": [0, 0, 0, 0]
              }
            ]
          ]
        },
        "layout": "noBorders"
      },
      {
        "style": "noc-table",
        "table": {
          "widths": ["20%", "26%", "5%", "22%", "26%"],
          "body": [
            [
              {
                "text": "Receipt No",
                "border": [false, true, false, false],
                "style": "receipt-table-value"
              },
              {
                "text": "{{receiptNo}}",
                "border": [false, true, false, false],
                "style": "receipt-table",
                "font": "Roboto"
              },
              {
                "text": "",
                "border": [false, true, false, false],
                "style": "receipt-table"
              },
              {
                "text": "Date",
                "border": [false, true, false, false],
                "style": "receipt-table-value"
              },
              {
                "text": "{{currentDate}}",
                "border": [false, true, false, false],
                "style": "receipt-table",
                "font": "Roboto"
              }
            ],
            [
              {
                "text": "{{booking_no}}",
                "border": [false, false, false, false],
                "style": "receipt-table-value"
              },
              {
                "text": "{{consumerID}}",
                "border": [false, false, false, false],
                "style": "receipt-table",
                "font": "Roboto"
              },
              {
                "text": "",
                "border": [false, false, false, false],
                "style": "receipt-table"
              },
              {
                "text": "Payment Mode",
                "border": [false, false, false, false],
                "style": "receipt-table-value"
              },
              {
                "text": "{{paymentMode}}",
                "border": [false, false, false, false],
                "style": "receipt-table",
                "font": "Roboto"
              }
            ],
            [
              {
                "text": "Trans ID",
                "border": [false, false, false, false],
                "style": "receipt-table-value"
              },
              {
                "text": "{{transactionID}}",
                "border": [false, false, false, false],
                "style": "receipt-table",
                "font": "Roboto"
              },
              {
                "text": "",
                "border": [false, false, false, false],
                "style": "receipt-table"
              },
              {
                "text": "",
                "border": [false, false, false, false],
                "style": "receipt-table"
              },
              {
                "text": "",
                "border": [false, false, false, false],
                "style": "receipt-table"
              }
            ],
            [
              {
                "text": "Name",
                "border": [false, false, false, true],
                "style": "receipt-table-value"
              },
              {
                "text": "{{payerName}} | {{payerContact}}",
                "border": [false, false, false, true],
                "style": "receipt-table",
                "alignment": "left"
              },
              {
                "text": "",
                "border": [false, false, false, true],
                "style": "receipt-table"
              },
              {
                "text": "",
                "border": [false, false, false, true],
                "style": "receipt-table"
              },
              {
                "text": "",
                "border": [false, false, false, true],
                "style": "receipt-table"
              }
            ]
          ]
        },
        "layout": {}
      },
      {
        "style": "next-noc-table",
        "table": {
          "widths": ["8%", "22%", "35%", "15%", "20%"],
          "body": [
            [
              {
                "text": "Site Id",
                "style": "receipt-table-value",
                "border": [false, false, false, false],
                "alignment": "left",
                "margin": [10, 0, 0, 0]
              },
              {
                "text": "Site",
                "style": "receipt-table-value",
                "border": [false, false, false, false],
                "alignment": "left",
                "margin": [8, 0, 0, 0]
              },
              {
                "text": "Booked Dates",
                "style": "receipt-table-value",
                "border": [false, false, false, false],
                "alignment": "left",
                "margin": [8, 0, 0, 0]
              },
              {
                "text": "Price/Day",
                "style": "receipt-table-value",
                "border": [false, false, false, false],
                "alignment": "left",
                "margin": [10, 0, 0, 0]
              },
              {
                "text": "Cost",
                "style": "receipt-table-value",
                "border": [false, false, false, false],
                "alignment": "left",
                "margin": [10, 0, 0, 0]
              }
            ],
            "{{#var_cartdetails}}[{\"text\":\"{{advertisementId}}\",\"style\":\"receipt-tableee\",\"alignment\":\"left\",\"border\":[false,false,false,false]},{\"stack\":[{\"text\":\"{{faceArea}}\",\"alignment\":\"left\",\"border\":[false,false,false,false]},{\"text\":\"{{location}}\",\"alignment\":\"left\",\"margin\":[0,2,0,0],\"border\":[false,false,false,false]},{\"text\":\"{{advertisementName}}\",\"alignment\":\"left\",\"margin\":[0,2,0,0],\"border\":[false,false,false,false]},{\"text\":\"Pole No. {{poleNo}}\",\"alignment\":\"left\",\"margin\":[0,2,0,0],\"border\":[false,false,false,false]}],\"style\":\"receipt-tableee\",\"border\":[false,false,false,false]},{\"stack\":[{\"text\":\"{{startDate}} to {{endDate}}\",\"alignment\":\"left\",\"border\":[false,false,false,false]},{\"text\":\"({{numberOfDays}} Days)\",\"alignment\":\"left\",\"margin\":[0,2,0,0],\"border\":[false,false,false,false]}],\"style\":\"receipt-tableee\",\"border\":[false,false,false,false]},{\"text\":\"₹ {{amount}}\",\"style\":\"receipt-tableee\",\"alignment\":\"left\",\"border\":[false,false,false,false]},{\"text\":\"₹ {{amountForDaysChosen}}\",\"style\":\"receipt-tableee\",\"alignment\":\"left\",\"border\":[false,false,false,false]}]{{/var_cartdetails}}"
          ]
        },
        "layout": {}
      },
      {
        "style": "next-noc-table",
        "table": {
          "widths": ["100%"],
          "body": [
            [
              {
                "stack": [
                  {
                    "text": "{{adv_booking_fees}} : {{advBookingFees}}",
                    "alignment": "right",
                    "style": "receipt-table-value-down"
                  },
                  {
                    "text": "{{adv_service_charge}} : {{advServiceCharge}}",
                    "alignment": "right",
                    "style": "receipt-table-value-down"
                  },
                  {
                    "text": "{{adv_sgst}} : {{advSgst}}",
                    "alignment": "right",
                    "style": "receipt-table-value-down"
                  },
                  {
                    "text": "{{adv_cgst}} : {{advCgst}}",
                    "alignment": "right",
                    "style": "receipt-table-value-down"
                  },
                  {
                    "text": "{{adv_security_deposit}} : {{advSecurityDeposit}}",
                    "alignment": "right",
                    "style": "receipt-table-value-down"
                  },
                  {
                    "text": "{{total_amount}} : {{totalAmount}}",
                    "alignment": "right",
                    "style": "receipt-table-value-down",
                    "bold": true
                  }
                ],
                "border": [false, false, false, false],
                "margin": [0, 0, 20, 0]
              }
            ]
          ]
        },
        "layout": {}
      },
      {
        "style": "receipt-approver",
        "columns": [
          {
            "text": [
              {
                "text": "{{generated_on}}: ",
                "bold": true
              },
              {
                "text": "{{currentDate}}",
                "bold": false
              }
            ],
            "alignment": "left"
          }
        ]
      },
      {
        "style": "no-signature",
        "text": "{{no_signature}}",
        "alignment": "center"
      }
    ],
    "styles": {
      "noc-head": {
        "margin": [-30, -30, 0, 1]
      },
      "receipt-logo-header": {
        "color": "#000000",
        "fontSize": 14,
        "bold": true,
        "letterSpacing": 0.74,
        "margin": [0, 0, 0, 5]
      },
      "receipt-logo-sub-header": {
        "color": "#000000",
        "fontSize": 12,
        "letterSpacing": 0.6
      },
      "noc-table": {
        "fontSize": 10,
        "color": "#000000",
        "margin": [-25, 10, -22, -4]
      },
      "receipt-table-value-total-Qr": {
        "alignment": "right",
        "margin": [0, 3, 10, 0]
      },
      "receipt-table-value-down": {
        "color": "#000000",
        "bold": false,
        "fontSize": 10,
        "fontWeight": 400,
        "alignment": "left",
        "margin": [3, 5, 0, 5]
      },
      "next-noc-table": {
        "fontSize": 10,
        "color": "#000000",
        "margin": [-25, 28, -22, -8]
      },
      "receipt-table-value": {
        "color": "#000000",
        "bold": true,
        "fontSize": 10,
        "fontWeight": 500,
        "margin": [-2, 2, 0, 1]
      },
      "receipt-table": {
        "color": "#000000",
        "bold": false,
        "fontSize": 10,
        "fontWeight": 400,
        "margin": [-30, 2, 0, 1]
      },

      "receipt-tableee": {
        "color": "#000000",
        "bold": false,
        "fontSize": 10,
        "fontWeight": 400,
        "margin": [8, 0, 0, 0]
      },
      "receipt-approver": {
        "fontSize": 10,
        "bold": true,
        "margin": [-27, 50, -10, 0],
        "color": "#484848"
      },
      "no-signature": {
        "fontSize": 12,
        "margin": [-27, 35, -10, 0],
        "color": "#484848"
      },
      "pt-disclaimer": {
        "fontSize": 12,
        "margin": [-27, 30, -10, 0],
        "color": "#484848"
      },
      "pt-disclaimer-value": {
        "fontSize": 12,
        "margin": [2, 3, 0, 0],
        "color": "#484848"
      }
    }
  }
}
