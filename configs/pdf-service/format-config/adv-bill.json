              {
                "text": "{{payerName}} | {{payerContact}}",
                "border": [false, false, false, true],
                "style": "receipt-table",
                "alignment": "left"
              },
              {
                "text": "",
                "border": [false, false, false, true],
                "style": "receipt-table"
              },
              {
                "text": "",
                "border": [false, false, false, true],
                "style": "receipt-table"
              },
              {
                "text": "",
                "border": [false, false, true, true],
                "style": "receipt-table"
              }
            ]
