{
  "key": "adv-bill",
  "config": {
    "defaultStyle": {
      "font": "Roboto",
      "fontSize" :12
    },
    "content": [
      {
        "style": "noc-head",
        "table": {
          "widths": [90, "*", 90],
          "body": [
            [
              {
                "image": "{{logoImage}}",
                "width": 70,
                "height": 70,
                "alignment": "left"
              },
              {
                "stack": [
                  {
                    "text": "{{ulbType}} {{logo-header}}",
                    "style": "receipt-logo-header",
                    "alignment": "center",
                    "margin": [0, 5, 0, 5]
                  },
                  {
                    "stack": [
                      { "text": "{{address}}" },
                      { "text": "{{phoneNumber}}" },
                      { "text": "{{website}}" },
                      { "text": "{{email}}" }
                    ],
                    "alignment": "center",
                    "color": "#484848",
                    "margin": [0, 2, 0, 2]
