              },
              {
                "text": "",
                "border": [false, false, false, false],
                "style": "receipt-table"
              },
              {
                "text": "",
                "border": [false, false, false, false],
                "style": "receipt-table"
              },
              {
                "text": "",
                "border": [false, false, true, false],
                "style": "receipt-table"
              }
            ],
            [
              {
                "text": "Name",
