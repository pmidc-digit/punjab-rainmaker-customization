      "receipt-logo-sub-header": {
        "color": "#000000",
        "fontSize": 12,
        "letterSpacing": 0.6
      },
      "noc-table": {
        "fontSize": 10,
        "color": "#000000",
        "margin": [-25, 5, 0, 0]
