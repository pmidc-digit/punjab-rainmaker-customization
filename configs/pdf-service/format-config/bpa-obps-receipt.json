{
  "key": "bpa-obps-receipt",
  "config": {
    "defaultStyle": { "font": "Roboto" },
    "content": [
      {
        "style": "noc-head",
        "table": {
          "widths": ["*"],
          "body": [
            [
              {
                "stack": [
                  {
                    "text": "Department of Local Government, Punjab",
                    "bold": true,
                    "fontSize": 13
                  },
                  {
                    "text": "{{ulbType}} {{logo-header}}",
                    "bold": true,
                    "fontSize": 13
                  },
                  {
                    "text": "{{address}}",
                    "bold": true,
                    "fontSize": 11
                  },
                  {
                    "text": [
                      { "text": "Website: ", "bold": true },
                      { "text": "{{website}}" }
                    ],
                    "fontSize": 11,
                    "alignment": "center",
                    "margin": [0, 2, 0, 0]
                  }
                ],
                "alignment": "center",
                "color": "#484848",
                "margin": [0, -10, 0, 10]
              }
            ]
          ]
        },
        "layout": "noBorders"
      },

      {
        "style": "noc-table",
        "table": {
          "widths": ["23%", "27%", "23%", "27%"],
          "body": [
            [
              {
                "text": "{{receipt_no}} ",
                "style": "receipt-table-value"
              },
              {
                "text": "{{receiptNo}}",
                "style": "receipt-table",
                "fontSize": 10
              },
              {
                "text": "File No ",
                "style": "receipt-table-value"
              },
              {
                "text": "{{consumerID}}",
                "style": "receipt-table",
                "fontSize": 10
              }
            ],
            [
              {
                "text": "{{payment_date}} ",
                "style": "receipt-table-value"
              },
              {
                "text": "{{paymentDate}}",
                "style": "receipt-table"
              },
              {
                "text": "Applicant Name ",
                "style": "receipt-table-value"
              },
              {
                "text": "{{payerName}}",
                "style": "receipt-table"
              }
            ],
            [
              {
                "text": "Applicant Contact No. ",
                "style": "receipt-table-value",
                "fontSize": 10
              },
              {
                "text": "{{payerContact}}",
                "style": "receipt-table",
                "border": [true, true, false, true]
              },
              {
                "text": " ",
                "border": [false, true, false, true]
              },
              {
                "text": " ",
                "border": [false, true, true, true]
              }
            ]
          ]
        }
      },

      {
        "style": "noc-mock-table",
        "table": {
          "widths": ["24%", "28%", "9%", "13%", "11%", "15%"],
          "body": [
            [
              {
                "text": "Type of Fees ",
                "style": "receipt-mock-table-value"
              },
              {
                "text": "{{paymentType}}",
                "style": "receipt-mock-table",
                "fontSize": 10
              },
              {
                "text": "Module ",
                "style": "receipt-mock-table-value"
              },
              {
                "text": "Building Plan Approval",
                "style": "receipt-mock-table",
                "fontSize": 10
              },
              {
                "text": "Category ",
                "style": "receipt-mock-table-value"
              },
              {
                "text": "{{Category}}",
                "style": "receipt-mock-table",
                "fontSize": 10
              }
            ]
          ]
        },
        "layout": {}
      },

      {
        "style": "next-noc-table",
        "table": {
          "widths": ["23%", "27%", "23%", "27%"],
          "body": [
            [
              {
                "text": "{{service_type}} ",
                "style": "receipt-table-value"
              },
              {
                "text": "{{serviceType}}",
                "style": "receipt-table"
              },
              {
                "text": "{{paid_amount}} ",
                "style": "receipt-table-value"
              },
              {
                "text": "₹ {{paidAmount}}",
                "style": "receipt-table"
              }
            ],
            [
              {
                "text": "Txn ID / UTR ",
                "style": "receipt-table-value"
              },
              {
                "text": "{{transactionID}}",
                "style": "receipt-table",
                "fontSize": 10,
                "colSpan": 3
              },
              {},
              {}
            ]
          ]
        }
      },

      {
        "style": "noc-mock-table",
        "table": {
          "widths": ["100%"],
          "body": [
            [
              {
                "text": "Detail of Payment",
                "style": "receipt-mock-table-value",
                "border": [true, true, true, false],
                "fontSize": 12
              }
            ]
          ]
        },
        "layout": {}
      },

      {
        "style": "fee-summary-table",
        "table": {
          "widths": ["22%", "78%"],
          "body": [
            [
              {
                "text": "Charges",
                "style": "receipt-fee-label"
              },
              {
                "text": "Amount (In ₹)",
                "style": "receipt-fee-label",
                "alignment": "right",
                "margin": [0, 0, 4, 0]
              }
            ],
            [
              {
                "text": "Building Application Fees ",
                "style": "receipt-fee-label"
              },
              {
                "text": " {{buildingApplicationFees}}",
                "style": "receipt-fee-value"
              }
            ],
            [
              {
                "text": "Boundary Wall Fees ",
                "style": "receipt-total-label",
                "fillColor": "#f2f2f2"
              },
              {
                "text": " {{boundaryWallFee}}",
                "style": "receipt-total-value",
                "fillColor": "#f2f2f2"
              }
            ],

            [
              {
                "text": "{{total_amount}}",
                "style": "receipt-total-label",
                "fillColor": "#f2f2f2"
              },
              {
                "text": " {{totalAmount}}",
                "style": "receipt-total-value",
                "fillColor": "#f2f2f2"
              }
            ],
            [
              {
                "text": " Amount in Words ",
                "style": "receipt-total-label",
                "fillColor": "#f2f2f2"
              },
              {
                "text": " {{Amountinwords}} only.",
                "style": "receipt-total-value",
                "fillColor": "#f2f2f2"
              }
            ]
          ]
        },
        "layout": {}
      },

      {
        "style": "receipt-approver",
        "columns": [
          {
            "text": [{ "text": "{{generated_by}}: ", "bold": true }],
            "alignment": "left"
          },
          {
            "ul": [
              {
                "text": "{{user-name}}",
                "listType": "none",
                "margin": [-90, 0, 0, 0]
              },
              {
                "text": "{{generator_mobileno}}",
                "listType": "none",
                "margin": [-90, 0, 0, 0]
              }
            ],
            "alignment": "left"
          },
          {
            "ul": [
              { "text": "{{ulbType}}", "bold": true,"listType": "none" },
              { "text": "{{logo-header}}", "bold": true,"listType": "none" }
            ],
            "alignment": "right",
            "margin": [0, 0, -2, 0]
          }
        ]
      },
      {
        "style": "pt-disclaimer",
        "stack": [
          {
            "text": "Disclaimer",
            "bold": true,
            "style": "pt-disclaimer-header"
          },

          {
            "ol": [
              " This receipt is generated electronically by the Building Plan Approval System of the {{ulbType}} {{logo-header}}.",
              " In case of any discrepancies, kindly contact the concerned municipal office with a copy of this receipt.",
              " The ULB shall not be responsible for delays caused due to banking network or technical issues.",
              " Retain this receipt for future reference."
            ],
            "alignment": "justify",
            "margin": [20, 0, 0, 10]
          }
        ]
      },
      {
        "style": "no-signature",
        "text": "This is a system-generated receipt and does not require a physical signature.",
        "margin": [0, 4, 0, 0]
      }
    ],

    "styles": {
      "noc-head": { "margin": [0, -20, 0, 10] },
      "noc-table": {
        "fontSize": 12,
        "color": "#000000",
        "margin": [0, 0, 0, 5]
      },

      "noc-mock-table": {
        "fontSize": 12,
        "color": "#000000",
        "margin": [0, 2, 0, 0]
      },
      "next-noc-table": {
        "fontSize": 12,
        "color": "#000000",
        "margin": [0, 15, 0, 10]
      },
      "receipt-table-value": {
        "color": "#000000",
        "bold": true,
        "fontSize": 10,
        "margin": [2, 4, 0, 4]
      },
      "receipt-mock-table-value": {
        "color": "#000000",
        "bold": true,
        "fontSize": 10,
        "margin": [2, 0, 0, 0]
      },
      "receipt-table": {
        "color": "#000000",
        "bold": false,
        "fontSize": 10,
        "margin": [2, 4, 0, 4]
      },
      "receipt-mock-table": {
        "color": "#000000",
        "bold": false,
        "fontSize": 10,
        "margin": [2, 0, 0, 0]
      },
      "receipt-fee-label": {
        "fontSize": 10,
        "color": "#000000",
        "bold": true,
        "margin": [4, 0, 0, 6]
      },
      "receipt-fee-value": {
        "fontSize": 10,
        "color": "#000000",
        "alignment": "right",
        "margin": [0, 6, 4, 6]
      },
      "receipt-total-label": {
        "fontSize": 10,
        "color": "#000000",
        "bold": true,
        "margin": [4, 6, 0, 6]
      },
      "receipt-total-value": {
        "fontSize": 10,
        "color": "#000000",
        "bold": true,
        "alignment": "right",
        "margin": [0, 6, 4, 6]
      },
      "receipt-approver": {
        "fontSize": 10,
        "bold": true,
        "margin": [0, 5, 0, 2],
        "color": "#484848"
      },
      "no-signature": {
        "fontSize": 10,
        "margin": [0, 5, 0, 5],
        "color": "#484848",
        "alignment": "center"
      },
      "pt-disclaimer": {
        "fontSize": 10,
        "margin": [0, 5, 0, 0],
        "color": "#484848"
      },
      "pt-disclaimer-header": {
        "fontSize": 11,
        "bold": true,
        "margin": [0, 0, 0, 4],
        "color": "#000000"
      },
      "pt-disclaimer-value": {
        "fontSize": 10,
        "margin": [2, 3, 0, 0],
        "color": "#484848",
        "alignment": "justify"
      }
    }
  }
}
