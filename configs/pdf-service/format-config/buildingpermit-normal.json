{
  "key": "buildingpermit-normal",
  "config": {
    "defaultStyle": {
      "font": "Roboto",
      "fontSize": 8
    },
    "content": [
      {
        "columns": [
          {
            "image":"{{newlogoImage}}",
            "width": 60,
            "height": 70,
            "margin": [0, -8, 0, 0]
          },
          {
            "stack": [
              {
                "text": "{{ulbType}}, {{ulbName}} ",
                "style": "sub-header",
                "alignment": "center",
                "margin": [0, 3, 0, 0],
                "fontSize": 12,
                "bold": true
              },
              {
                "text": "Building Permit/ Sanction Letter",
                "style": "header",
                "alignment": "center",
                "fontSize": 10,
                "margin": [0, -1, 0, 0],
                "bold": true
              }
            ],
            "margin": [0, -10, 0, 0],
            "width": "*",
            "alignment": "center"
          },
          {
            "image": "{{qrCode}}",
            "alignment": "right",
            "width": 60,
            "height": 70,
            "margin": [0, -10, 0, 0]
          }
        ],
        "margin": [0, -10, 0, 0]
      },
      {
        "columns": [
          {
            "text": [
              {
                "text": "File/B.A. No. :",
                "bold": true
              },
              {
                "text": " {{applicationNo}}",
                "bold": false,
                "font": "Roboto"
              }
            ]
          },
          {
            "text": [
              {
                "text": " Date: ",
                "bold": true,
                "alignment": "right"
              },
              {
                "text": " {{approvalDate}}",
                "bold": false,
                "alignment": "right"
              }
            ]
          }
        ],
        "margin": [0, 5, 0, 0],
        "style": "top-margin"
      },
      {
        "columns": [
          {
            "text": [
              {
                "text": "To : ",
                "bold": true
              },
              {
                "text": "{{#var_owners}}{{ownerName}} , {{ownerAddress}},{{/var_owners}}",
                "bold": false
              }
            ]
          }
        ],
        "style": "top-margin"
      },
      {
        "columns": [
          {
            "text": "Subject :  ",
            "bold": true,
            "width": "auto"
          },
          {
            "text": "{{subjectLine}} {{ulbType}}",
            "decoration": "underline",
            "width": "auto",
            "bold": true,
            "margin": [5, 0, 0, 0],
            "font": "Roboto"
          }
        ],
        "margin": [0, 5, 0, 0],
        "alignment": "justify",
        "style": "top-margin"
      },
      {
        "text": [
          {
            "text": "Dear Sir or Madam , "
          }
        ],
        "margin": [0, 0, 0, 10]
      },
      {
        "columns": [
          {
            "stack": [
              {
                "text": "  ",
                "margin": [15, 0, 0, 0]
              }
            ]
          },
          {
            "text": [
              {
                "text": "With reference to your application dated "
              },
              {
                "text": "{{submissionDate}} at time {{submissionDateEpochIST}} ",
                "bold": true
              },
              {
                "text": "submitted through "
              },
              {
                "text": "{{profession}}, {{stakeholderName}} ",
                "bold": true
              },
              {
                "text": "for the grant of sanction to erect/re-erect/add to/alteration of "
              },
              {
                "text": " {{RESIDENTIAL_PLOTTED}} ",
                "bold": true
              },
              {
                "text": " Building having  :"
              },
              {
                "text": " Plot Size :",
                "bold": true
              },
              {
                "text": " {{plotArea}} sq.meters, ",
                "bold": true
              },
              {
                "text": " {{PLOT_NO}} :",
                "bold": true
              },
              {
                "text": " {{plotNo}}, ",
                "bold": true,
                "font": "Roboto"
              },
              {
                "text": "Ward No : ",
                "bold": true
              },
              {
                "text": " {{wardNo}}, ",
                "bold": true
              },
              {
                "text": " situated in/at"
              },
              {
                "text": " {{locality}} , {{pincode}}. ",
                "bold": true,
                "font": "Roboto"
              },
              {
                "text": "Approval is subject to the following conditions and corrections done in the plans has sanctioned the same on"
              },
              {
                "text": " {{approvalDate}}."
              }
            ],
            "margin": [-230, -1, 0, 0],
            "alignment": "justify"
          }
        ]
      },

      {
        "columns": [
          {
            "stack": [
              {
                "text": "   ",
                "margin": [15, 0, 0, 0]
              }
            ]
          },
          {
            "text": [
              {
                "text": " The plans are valid up to "
              },
              {
                "text": "{{newValidityDate}}.",
                "bold": true
              }
            ],

            "margin": [-230, 0, 0, 0],
            "alignment": "justify",
            "style": "top-margin"
          }
        ]
      },

      {
        "ol": [
          { "text": "{{BPA_NORMAL_TERMS_1}}", "margin": [0, 2, 0, 2] },
          { "text": "{{BPA_NORMAL_TERMS_2}}", "margin": [0, 2, 0, 2] },
          { "text": "{{BPA_NORMAL_TERMS_3}}", "margin": [0, 2, 0, 2] },
          { "text": "{{BPA_NORMAL_TERMS_4}}", "margin": [0, 2, 0, 2] },
          { "text": "{{BPA_NORMAL_TERMS_5}}", "margin": [0, 2, 0, 2] },
          { "text": "{{BPA_NORMAL_TERMS_6}}", "margin": [0, 2, 0, 2] },
          { "text": "{{BPA_NORMAL_TERMS_7}}", "margin": [0, 2, 0, 2] },
          { "text": "{{BPA_NORMAL_TERMS_8}}", "margin": [0, 2, 0, 2] },
          { "text": "{{BPA_NORMAL_TERMS_9}}", "margin": [0, 2, 0, 2] },
          { "text": "{{BPA_NORMAL_TERMS_10}}", "margin": [0, 2, 0, 2] },
          { "text": "{{BPA_NORMAL_TERMS_11}}", "margin": [0, 2, 0, 2] },
          { "text": "{{BPA_NORMAL_TERMS_12}}", "margin": [0, 2, 0, 2] },
          { "text": "{{BPA_NORMAL_TERMS_13}}", "margin": [0, 2, 0, 2] },
          { "text": "{{BPA_NORMAL_TERMS_14}}", "margin": [0, 2, 0, 2] },
          { "text": "{{BPA_NORMAL_TERMS_15}}", "margin": [0, 2, 0, 2] },
          { "text": "{{BPA_NORMAL_TERMS_16}}", "margin": [0, 2, 0, 2] }
        ],

        "margin": [0, 0, 0, 0]
      },
      {
        "table": {
          "widths": ["3%", "97%"],
          "body": [
            "[{\"text\":\"\",\"style\":\"receipt-table-value-down\",\"alignment\":\"left\",\"margin\":[0,2,0,2]},{\"text\":\"{{approverCommentLine}}\",\"style\":\"receipt-table-value-down\",\"alignment\":\"justify\",\"margin\":[0,2,0,2]}]",
            "[{\"text\":\"\",\"style\":\"receipt-table-value-down\",\"alignment\":\"left\",\"margin\":[0,2,0,2]}, {\"text\":\"{{approverComment}}\",\"style\":\"receipt-table-value-down\",\"alignment\":\"justify\",\"margin\":[0,2,0,2], \"bold\":true}]"
          ]
        },
        "layout": "noBorders",
        "margin": [-22, 0, 5, 0]
      }
    ],

    "styles": {
      "header": {
        "bold": true,
        "alignment": "center"
      },
      "sub-header": {
        "alignment": "center",
        "margin": [0, 2, 0, 5]
      },
      "top-margin": {
        "margin": [0, 2, 0, 0]
      },
      "top-high-margin": {
        "margin": [0, 0, 0, 0]
      }
    }
  }
}
