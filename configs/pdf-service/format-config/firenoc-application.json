{
  "key": "firenoc-application",
  "config": {
    "defaultStyle": {
      "font": "Roboto"
    },
    "content": [
      {
        "style": "noc-head",
        "table": {
          "widths": [90, "*", 90],
          "body": [
            [
              {
                "image": "{{logoImage}}",
                "width": 60,
                "height": 60,
                "alignment": "left"
              },
              {
                "stack": [
                  {
                    "text": "{{ulbType}} {{logo-header}}",
                    "style": "receipt-logo-header",
                    "alignment": "center",
                    "margin": [0, 5, 0, 5]
                  },
                  {
                    "stack": [
                      { "text": "{{address}}" },
                      { "text": "{{website}}" },
                      { "text": "{{email}}" },
                      { "text": "{{phoneNumber}}" }
                    ],
                    "alignment": "center",
                    "color": "#484848",
                    "margin": [0, 2, 0, 2]
                  },
                  {
                    "text": "Fire NOC Application Confirmation Form",
                    "style": "receipt-logo-sub-header",
                    "alignment": "center",
                    "margin": [0, 5, 0, 0]
                  }
                ],
                "alignment": "center"
              },
              {
                "image": "{{qrcodeimage}}",
                "width": 72,
                "height": 72,
                "alignment": "right",
                "margin": [0, 0, 0, 0]
              }
            ]
          ]
        },
        "layout": "noBorders"
      },
      {
        "style": "noc-table",
        "table": {
          "widths": ["26%", "21%", "27%", "26%"],
          "body": [
            [
              {
                "text": "Fire NOC Number",
                "border": [true, true, false, false],
                "style": "receipt-table-value"
              },
              {
                "text": "{{fireNOCNumber}}",
                "border": [false, true, false, false],
                "style": "receipt-table",
                "font": "Roboto"
              },
              {
                "text": "Application Number",
                "border": [false, true, false, false],
                "style": "receipt-table-value"
              },
              {
                "text": "{{consumerID}}",
                "border": [false, true, true, false],
                "style": "receipt-table",
                "font": "Roboto"
              }
            ],
            [
              {
                "text": "Application Date",
                "border": [true, false, false, false],
                "style": "receipt-table-value"
              },
              {
                "text": "{{issuedDate}}",
                "border": [false, false, false, false],
                "style": "receipt-table"
              },
              {
                "text": "Applicant Name",
                "border": [false, false, false, false],
                "style": "receipt-table-value"
              },
              {
                "text": "{{#var_owners}} {{name}} {{/var_owners}}",
                "border": [false, false, true, false],
                "style": "receipt-table"
              }
            ],
            [
              {
                "text": "Applicant Contact",
                "border": [true, false, false, true],
                "style": "receipt-table-value"
              },
              {
                "text": "{{#var_owners}} {{mobileNumber}} {{/var_owners}}",
                "border": [false, false, false, true],
                "style": "receipt-table"
              },
              {
                "text": "Application Status",
                "border": [false, false, false, true],
                "style": "receipt-table-value"
              },
              {
                "text": "{{appStatus}}",
                "border": [false, false, true, true],
                "style": "receipt-table"
              }
            ]
          ]
        },
        "layout": {}
      },
      {
        "style": "next-noc-table",
        "table": {
          "widths": ["27%", "20%", "21%", "32%"],
          "body": [
            [
              {
                "text": "City",
                "border": [true, true, false, false],
                "style": "receipt-table-value"
              },
              {
                "text": "{{city}}",
                "border": [false, true, false, false],
                "style": "receipt-table"
              },
              {
                "text": "Validity date",
                "border": [false, true, false, false],
                "style": "receipt-table-value"
              },
              {
                "text": "{{validTo}}",
                "border": [false, true, true, false],
                "style": "receipt-table"
              }
            ],
            [
              {
                "text": "Area Type",
                "border": [true, false, false, false],
                "style": "receipt-table-value"
              },
              {
                "text": "{{areaType}}",
                "border": [false, false, false, false],
                "style": "receipt-table"
              },
              {
                "text": "Locality",
                "border": [false, false, false, false],
                "style": "receipt-table-value"
              },
              {
                "text": "{{locality}}",
                "border": [false, false, true, false],
                "style": "receipt-table"
              }
            ],
            [
              {
                "text": "Pincode",
                "border": [true, false, false, false],
                "style": "receipt-table-value"
              },
              {
                "text": "{{pincode}}",
                "border": [false, false, false, false],
                "style": "receipt-table"
              },
              {
                "text": "Street Name",
                "border": [false, false, false, false],
                "style": "receipt-table-value"
              },
              {
                "text": "{{street}}",
                "border": [false, false, true, false],
                "style": "receipt-table",
                "font": "Roboto"
              }
            ],

            [
              {
                "text": "Building Name",
                "border": [true, false, false, false],
                "style": "receipt-table-value"
              },
              {
                "text": "{{#var_buildings}} {{buildingName}} {{/var_buildings}}",
                "border": [false, false, false, false],
                "style": "receipt-table"
              },
              {
                "text": "Usage Type",
                "border": [false, false, false, false],
                "style": "receipt-table-value"
              },
              {
                "text": "{{#var_buildings}} {{usageType}} {{/var_buildings}}",
                "border": [false, false, true, false],
                "style": "receipt-table"
              }
            ],
            [
            {
                "text": "Usage Sub Type",
                "border": [true, false, false, true],
                "style": "receipt-table-value"
              },
              {
                "text": "{{#var_buildings}} {{usageSubType}} {{/var_buildings}}",
                "border": [false, false, false, true],
                "style": "receipt-table"
              },
              {
                "text": "Land Area",
                "border": [false, false, false, true],
                "style": "receipt-table-value"
              },
              {
                "text": "{{#var_buildings}} {{landArea}} Sq. M. {{/var_buildings}}",
                "border": [false, false, true, true],
                "style": "receipt-table"
              }
            ]
          ]
        },
        "layout": {}
      },

      
      {
        "style": "receipt-approver",
        "columns": [
          {
            "text": [
              {
                "text": "{{generated_by}}: ",
                "bold": true
              },
              {
                "text": "{{user-name}}",
                "bold": false
              }
            ],
            "alignment": "left"
          }
        ]
      }
    ],
    "styles": {
      "noc-head": {
        "margin": [-30, -30, 0, 1]
      },
      "receipt-logo-header": {
        "color": "#000000",
        "fontSize": 14,
        "bold": true,
        "letterSpacing": 0.74,
        "margin": [0, 0, 0, 5]
      },
      "receipt-logo-sub-header": {
        "color": "#000000",
        "fontSize": 12,
        "letterSpacing": 0.6
      },
      "noc-table": {
        "fontSize": 12,
        "color": "#000000",
        "margin": [-25, 4, -22, 4]
      },
      "receipt-table-value-total-Qr": {
        "alignment": "right",
        "margin": [0, 3, 10, 0]
      },
      "receipt-table-value-down": {
        "color": "#000000",
        "bold": false,
        "fontSize": 12,
        "fontWeight": 400,
        "alignment": "left",
        "margin": [3, 0, 0, 0]
      },
      "noc-mock-table": {
        "fontSize": 12,
        "color": "#000000",
        "margin": [-25, 7, 0, 0]
      },
      "receipt-mock-table-value": {
        "color": "#000000",
        "bold": true,
        "fontSize": 10,
        "margin": [2, 0, 0, 0]
      },
      "receipt-mock-table": {
        "color": "#000000",
        "bold": false,
        "fontSize": 10,
        "margin": [2, 0, 0, 0]
      },
      "next-noc-table": {
        "fontSize": 12,
        "color": "#000000",
        "margin": [-25, 4, -22, 2]
      },
      "receipt-table-value": {
        "color": "#000000",
        "bold": true,
        "fontSize": 12,
        "fontWeight": 500,
        "margin": [-2, 2, 0, 2]
      },
      "receipt-table": {
        "color": "#000000",
        "bold": false,
        "fontSize": 12,
        "fontWeight": 400,
        "margin": [-30, 2, 0, 2]
      },
      "receipt-approver": {
        "fontSize": 12,
        "bold": true,
        "margin": [-27, 6, -10, 0],
        "color": "#484848"
      },
      "no-signature": {
        "fontSize": 12,
        "margin": [-27, 200, -10, 0],
        "color": "#484848"
      },
      "pt-disclaimer": {
        "fontSize": 12,
        "margin": [-27, 5, -10, 0],
        "color": "#484848"
      },
      "pt-disclaimer-value": {
        "fontSize": 12,
        "margin": [2, 3, 0, 0],
        "color": "#484848"
      }
    }
  }
}
