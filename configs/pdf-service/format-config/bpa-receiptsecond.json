      "receipt-total-label": { "fontSize": 11, "color": "#000000", "bold": true, "margin": [4, 0, 0, 0] },
      "receipt-total-value": { "fontSize": 11, "color": "#000000", "bold": true, "alignment": "right", "margin": [0, 2, 4, 2] },
      "receipt-approver": { "fontSize": 11, "bold": true, "margin": [0, 0, 0, 0], "color": "#484848" },
      "no-signature": { "fontSize": 10, "margin": [0, 0, 0, 0], "color": "#484848", "alignment": "center" },
      "pt-disclaimer": { "fontSize": 10, "margin": [0, 0, 0, 0], "color": "#484848" },
      "pt-disclaimer-header": { "fontSize": 10, "bold": true, "margin": [0, 0, 0, 0], "color": "#000000" },
      "pt-disclaimer-value": { "fontSize": 9, "margin": [2, 0, 0, 0], "color": "#484848", "alignment": "justify" }
