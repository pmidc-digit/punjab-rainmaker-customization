},


      {
  "style": "receipt-approver",
  "columns": [
    {
      "text": [
        { "text": "{{generated_by}}: ", "bold": true }
      ],
      "alignment": "left"
    },
    {
      "ul": [
        { "text": "{{user-name}}","listType": "none", "margin": [ -90, 0, 0, 0 ] },
        { "text": "{{generator_mobileno}}" ,"listType": "none","margin": [ -90, 0, 0, 0 ]}
      ],
      "alignment": "left"
    },
    {
      "text": [
        { "text": "Municipal Corporation, Amritsar", "bold": true }
      ],
      "alignment": "right",
      "margin": [0, 0, -10, 0]
    }
  ]
},

     

      {
        "style": "pt-disclaimer",
        "stack": [
          { "text": "Disclaimer", "bold": true, "style": "pt-disclaimer-header" },
          
           {
          "ol": [
             " This receipt is generated electronically by the Building Plan Approval System of the Municipal Corporation Amritsar.",
              " Payment details shown above are based on records available at the time of generation.",
              " In case of any discrepancies, kindly contact the concerned municipal office with a copy of this receipt.",
              " The Corporation shall not be responsible for delays caused due to banking network or technical issues.",
              " Retain this receipt for future reference — it serves as proof of payment."
          ],
          "alignment": "justify",
          "margin": [20, 0, 0, 0]
        }
        ]
      },
       {
        "style": "no-signature",
        "text": "This is a system-generated receipt and does not require a physical signature."
      }
    ],

    "styles": {
      "noc-head": { "margin": [0, -20, 0, 0] },
      "noc-mock-table": {
        "fontSize": 11,
        "color": "#000000",
        "margin": [0, 2, 0, 0]
      },
      "noc-table": { "fontSize": 11, "color": "#000000", "margin": [0, 0, 0, 0] },
      "next-noc-table": { "fontSize": 11, "color": "#000000", "margin": [0, 0, 0, 0] },
      "receipt-table-value": { "color": "#000000", "bold": true, "fontSize": 11, "margin": [2, 0, 0, 0] },
      "receipt-table": { "color": "#000000", "bold": false, "fontSize": 11, "margin": [2, 0, 0, 0] },
      "receipt-mock-table-value": {
        "color": "#000000",
        "bold": true,
        "fontSize": 12,
        "margin": [2, 0, 0, 0]
      },
      "receipt-fee-label": { "fontSize": 10, "color": "#000000", "bold": true, "margin": [4,0,0,0] },
