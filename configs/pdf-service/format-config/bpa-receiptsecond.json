{
  "key": "bpa-receiptsecond",
  "config": {
    "defaultStyle": { "font": "Roboto", "fontSize": 11 },
    "content": [
      {
        "style": "noc-head",
        "table": {
          "widths": ["*"],
          "body": [
            [
              {
                "stack": [
                  {
                    "text": "Department of Local Government, Punjab",
                    "bold": true,
                    "fontSize": 11
                  },
                  {
                    "text": "{{ulbType}} {{logo-header}}",
                    "bold": true,
                    "fontSize": 11
                  },
                  {
                    "text": "{{address}}",
                    "bold": true,
                    "fontSize": 9
                  },
                  {
                    "text": [
                      { "text": "Website: ", "bold": true },
                      { "text": "{{website}}" }
                    ],
                    "fontSize": 9,
                    "alignment": "center",
                    "margin": [0, 2, 0, 0]
                  }
                ],
                "alignment": "center",
                "color": "#484848",
                "margin": [0, -10, 0, 0]
              }
            ]
          ]
        },
        "layout": "noBorders"
      },

      {
        "style": "noc-table",
        "table": {
          "widths": ["23%", "27%", "23%", "27%"],
          "body": [
            [
              {
                "text": "{{receipt_no}} ",
                "style": "receipt-table-value"
              },
              {
                "text": "{{receiptNo}}",
                "style": "receipt-table",
                "font": "Roboto",
                "fontSize": 10
              },
              {
                "text": "File No ",
                "style": "receipt-table-value"
              },
              {
                "text": "{{consumerID}}",
                "style": "receipt-table",
                "font": "Roboto",
                "fontSize": 10
              }
            ],
            [
              {
                "text": "{{payment_date}} ",
                "style": "receipt-table-value"
              },
              {
                "text": "{{paymentDate}}",
                "style": "receipt-table"
              },
              {
                "text": "Applicant Name ",
                "style": "receipt-table-value"
              },
              {
                "text": "{{payerName}}",
                "style": "receipt-table"
              }
            ],
            [
              {
                "text": "Applicant Contact No. ",
                "style": "receipt-table-value",
                "fontSize": 10
              },
              {
                "text": "{{payerContact}}",
                "style": "receipt-table",
                "border": [true, true, false, true]
