{
  "key": "bpa-receiptsecond",
  "config": {
    "defaultStyle": { "font": "Cambay" },
    "content": [
      {
        "style": "noc-head",
        "table": {
          "widths": ["*"],
          "body": [
            [
              {
                "stack": [
                  { "text": "Municipal Corporation Amritsar, C Block, Ranjit Avenue, Amritsar, Punjab", "bold": true, "fontSize": 13 },
                  { "text": "{{phoneNumber}}" },
                  { "text": "{{website}}" },
                  { "text": "{{email}}" }
                ],
                "alignment": "center",
                "color": "#484848",
                "margin": [0, -10, 0, 10]
              }
            ]
          ]
        },
        "layout": "noBorders"
      },

      {
        "style": "noc-table",
        "table": {
          "widths": ["28%", "22%", "26%", "24%"],
          "body": [
            [
              { "text": "{{receipt_no}}", "border": [true, true, false, false], "style": "receipt-table-value" },
              { "text": "{{receiptNo}}", "border": [false, true, false, false], "style": "receipt-table" },
              { "text": "File No:", "border": [false, true, false, false], "style": "receipt-table-value" },
              { "text": "{{consumerID}}", "border": [false, true, true, false], "style": "receipt-table" }
            ],
            [
              { "text": "{{payment_date}}", "border": [true, false, false, false], "style": "receipt-table-value" },
              { "text": "{{paymentDate}}", "border": [false, false, false, false], "style": "receipt-table" },
              { "text": "Applicant Name:", "border": [false, false, false, false], "style": "receipt-table-value" },
              { "text": "{{payerName}}", "border": [false, false, true, false], "style": "receipt-table" }
            ],
            [
              { "text": "Applicant Contact:", "border": [true, false, false, true], "style": "receipt-table-value" },
              { "text": "{{payerContact}}", "border": [false, false, false, true], "style": "receipt-table" },
              { "text": "Type of Fees:", "border": [false, false, false, true], "style": "receipt-table-value" },
              { "text": "{{paymentType}}", "border": [false, false, true, true], "style": "receipt-table" }
            ]
          ]
        }
      },

      {
        "style": "next-noc-table",
        "table": {
          "widths": ["30%", "20%", "25%", "25%"],
          "body": [
            [
              { "text": "{{service_type}}", "border": [true, true, false, false], "style": "receipt-table-value" },
              { "text": "{{serviceType}}", "border": [false, true, false, false], "style": "receipt-table" },
              { "text": "{{paid_amount}}", "border": [false, true, false, false], "style": "receipt-table-value" },
              { "text": "₹ {{paidAmount}}", "border": [false, true, true, false], "style": "receipt-table" }
            ],
            [
              { "text": "Txn ID / UTR:", "border": [true, false, false, true], "style": "receipt-table-value" },
              { "text": "{{transactionID}}", "border": [false, false, true, true], "style": "receipt-table", "colSpan": 3 },
              {},
              {}
            ]
          ]
        }
      },

    {
  "style": "fee-summary-table",
  "table": {
    "widths": ["45%", "55%"],
    "body": [
      [
        { "text": " Labour Cess", "style": "receipt-fee-label", "border": [true, true, false, false] },
        { "text": "₹ {{bpaLabourCess}}", "style": "receipt-fee-value", "border": [false, true, true, false] }
      ],
      [
        { "text": " Gaushala Charges Cess", "style": "receipt-fee-label", "border": [true, false, false, false] },
        { "text": "₹ {{bpaGaushalaChargesCess}}", "style": "receipt-fee-value", "border": [false, false, true, false] }
      ],
      [
        { "text": " Mining Charges", "style": "receipt-fee-label", "border": [true, false, false, false] },
        { "text": "₹ {{bpaMiningCharges}}", "style": "receipt-fee-value", "border": [false, false, true, false] }
      ],
      [
        { "text": " Sub-Division Charges", "style": "receipt-fee-label", "border": [true, false, false, false] },
        { "text": "₹ {{bpaSubDivisionCharges}}", "style": "receipt-fee-value", "border": [false, false, true, false] }
      ],
      [
        { "text": " Development Charges", "style": "receipt-fee-label", "border": [true, false, false, false] },
        { "text": "₹ {{bpaDevelopmentCharges}}", "style": "receipt-fee-value", "border": [false, false, true, false] }
      ],
      [
        { "text": " Other Charges", "style": "receipt-fee-label", "border": [true, false, false, false] },
        { "text": "₹ {{bpaOtherCharges}}", "style": "receipt-fee-value", "border": [false, false, true, false] }
      ],
      [
        { "text": " Clubbing Charges", "style": "receipt-fee-label", "border": [true, false, false, false] },
        { "text": "₹ {{bpaClubbingCharges}}", "style": "receipt-fee-value", "border": [false, false, true, false] }
      ],
      [
        { "text": " Malba Charges", "style": "receipt-fee-label", "border": [true, false, false, false] },
        { "text": "₹ {{bpaMalbaCharges}}", "style": "receipt-fee-value", "border": [false, false, true, false] }
      ],
      [
        { "text": " Less Adjustment Plot", "style": "receipt-fee-label", "border": [true, false, false, false] },
        { "text": "₹ {{bpaLessAdjustmentPlot}}", "style": "receipt-fee-value", "border": [false, false, true, false] }
      ],
      [
        { "text": " Rain Water Harvesting Charges", "style": "receipt-fee-label", "border": [true, false, false, false] },
        { "text": "₹ {{bpaRainWaterHarvestingCharges}}", "style": "receipt-fee-value", "border": [false, false, true, false] }
      ],
      [
        { "text": " External Development Charges", "style": "receipt-fee-label", "border": [true, false, false, false] },
        { "text": "₹ {{bpaExternalDevelopmentCharges}}", "style": "receipt-fee-value", "border": [false, false, true, false] }
      ],
      [
        { "text": " CLU Charges", "style": "receipt-fee-label", "border": [true, false, false, false] },
        { "text": "₹ {{bpaCluCharges}}", "style": "receipt-fee-value", "border": [false, false, true, false] }
      ],
      [
        { "text": " Water Charges", "style": "receipt-fee-label", "border": [true, false, false, false] },
        { "text": "₹ {{bpaWaterCharges}}", "style": "receipt-fee-value", "border": [false, false, true, false] }
      ],
      [
        { "text": " Processing Fees", "style": "receipt-fee-label", "border": [true, false, false, false] },
        { "text": "₹ {{bpaProcessingFees}}", "style": "receipt-fee-value", "border": [false, false, true, false] }
      ],
      [
        { "text": " Urban Development Cess", "style": "receipt-fee-label", "border": [true, false, false, false] },
        { "text": "₹ {{bpaUrbanDevelopmentCess}}", "style": "receipt-fee-value", "border": [false, false, true, true] }
      ],
      [
        { "text": "{{total_amount}}", "style": "receipt-total-label", "border": [true, false, false, true], "fillColor": "#f2f2f2" },
        { "text": "₹ {{totalAmount}}", "style": "receipt-total-value", "border": [false, false, true, true], "fillColor": "#f2f2f2" }
      ]
    ]
  }
},


      {
        "style": "receipt-approver",
        "columns": [
          {
            "text": [
              { "text": "{{generated_by}}: ", "bold": true },
              { "text": "{{user-name}}" }
            ],
            "alignment": "left"
          },
          {
            "text": [
              { "text": "{{designation}}", "bold": true }
            ],
            "alignment": "right",
            "margin": [0, 0, -10, 0]
          }
        ]
      },

     

      {
        "style": "pt-disclaimer",
        "stack": [
          { "text": "Disclaimer", "bold": true, "style": "pt-disclaimer-header" },
          
           {
          "ol": [
             " This receipt is generated electronically by the Building Plan Approval System of the Municipal Corporation Amritsar.",
              " Payment details shown above are based on records available at the time of generation.",
              " In case of any discrepancies, kindly contact the concerned municipal office with a copy of this receipt.",
              " The Corporation shall not be responsible for delays caused due to banking network or technical issues.",
              " Retain this receipt for future reference — it serves as proof of payment."
          ],
          "alignment": "justify",
          "margin": [20, 0, 0, 10]
        }
        ]
      },
       {
        "style": "no-signature",
        "text": "This is a system-generated receipt and does not require a physical signature."
      }
    ],

    "styles": {
      "noc-head": { "margin": [0, -20, 0, 10] },
      "noc-table": { "fontSize": 12, "color": "#000000", "margin": [0, 10, 0, 5] },
      "next-noc-table": { "fontSize": 12, "color": "#000000", "margin": [0, 15, 0, 10] },
      "receipt-table-value": { "color": "#000000", "bold": true, "fontSize": 12, "margin": [2, 4, 0, 4] },
      "receipt-table": { "color": "#000000", "bold": false, "fontSize": 12, "margin": [2, 4, 0, 4] },
      "receipt-fee-label": { "fontSize": 12, "color": "#000000", "bold": true, "margin": [4, 6, 0, 6] },
      "receipt-fee-value": { "fontSize": 12, "color": "#000000", "alignment": "right", "margin": [0, 6, 4, 6] },
      "receipt-total-label": { "fontSize": 12, "color": "#000000", "bold": true, "margin": [4, 6, 0, 6] },
      "receipt-total-value": { "fontSize": 12, "color": "#000000", "bold": true, "alignment": "right", "margin": [0, 6, 4, 6] },
      "receipt-approver": { "fontSize": 12, "bold": true, "margin": [0, 40, 0, 10], "color": "#484848" },
      "no-signature": { "fontSize": 12, "margin": [0, 25, 0, 5], "color": "#484848", "alignment": "center" },
      "pt-disclaimer": { "fontSize": 11, "margin": [0, 20, 0, 0], "color": "#484848" },
      "pt-disclaimer-header": { "fontSize": 11, "bold": true, "margin": [0, 0, 0, 4], "color": "#000000" },
      "pt-disclaimer-value": { "fontSize": 11, "margin": [2, 3, 0, 0], "color": "#484848", "alignment": "justify" }
    }
  }
}
