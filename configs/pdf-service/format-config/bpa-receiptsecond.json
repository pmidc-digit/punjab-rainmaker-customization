          "widths": ["*"],
          "body": [
            [
              {
                "stack": [
                  {
                    "text": "Department of Local Government, Punjab",
                    "bold": true,
                    "fontSize": 11
                  },
                  {
                    "text": "Municipal Corporation Amritsar",
                    "bold": true,
                    "fontSize": 11
                  },
                  {
                    "text": "C Block, Ranjit Avenue, Amritsar, Punjab",
                    "bold": true,
                    "fontSize": 11
                  },
                  { "text": "{{phoneNumber}}" ,"fontSize": 9},
                  { "text": "{{website}}" ,"fontSize": 9},
                  { "text": "{{email}}","fontSize": 9 }
