            [
              {
                "text": "Type of Fees ",
                "style": "receipt-mock-table-value"
              },
              {
                "text": "{{paymentType}}",
                "style": "receipt-mock-table",
                "font": "Roboto",
                "fontSize": 10
              },
              {
                "text": "Module ",
                "style": "receipt-mock-table-value"
              },
              {
                "text": "Building Plan Approval",
                "style": "receipt-mock-table",
                "font": "Roboto",
                "fontSize": 10
              },
              {
                "text": "Category ",
                "style": "receipt-mock-table-value"
              },
              {
                "text": "{{Category}}",
                "style": "receipt-mock-table",
                "font": "Roboto",
                "fontSize": 10
              }
            ]
          ]
        },
        "margin": [0, 6, 0, 0],
        "layout": {}
      },
      {
        "style": "next-noc-table",
        "table": {
          "widths": ["23%", "27%", "23%", "27%"],
          "body": [
            [
              {
                "text": "{{service_type}} ",
                "style": "receipt-table-value",
                "border": [true, true, true, true]
              },
              {
                "text": "{{serviceType}}",
