              },
              {
                "text": "{{transactionID}}",
                "style": "receipt-table",
                "font": "Roboto",
                "fontSize": 10,
                "colSpan": 3
              },
              {},
              {}
            ]
          ]
        },
        "layout": {},
        "margin": [0, 6, 0, 4]
      },
