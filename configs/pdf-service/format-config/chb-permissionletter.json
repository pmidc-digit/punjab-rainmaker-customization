{
  "key": "chb-permissionletter",
  "config": {
    "defaultStyle": {
      "font": "Roboto",
      "fontSize": 10
    },
    "content": [
      {
        "style": "noc-head",
        "table": {
          "widths": [90, "*", 90],
          "body": [
            [
              {
                "image": "{{logoImage}}",
                "width": 60,
                "height": 60,
                "alignment": "left"
              },
              {
                "stack": [
                  {
                    "text": "{{ulbType}} {{logo-header}}",
                    "style": "receipt-logo-header",
                    "alignment": "center",
                    "margin": [20, 5, 0, 2]
                  },
                  {
                    "stack": [
                      { "text": "{{address}}" },
                      { "text": "{{website}}" },
                      { "text": "{{email}}" },
                      { "text": "{{phoneNumber}}" }
                    ],
                    "alignment": "center",
                    "color": "#484848",
                    "margin": [20, 0, 0, 0]
                  },
                  {
                    "text": "{{chb_service}} Permission Letter",
                    "style": "receipt-logo-sub-header",
                    "alignment": "center",
                    "margin": [20, 2, 0, 0]
                  }
                ],
                "alignment": "center"
              },
              {
                "image": "{{qrcodeimage}}",
                "width": 60,
                "height": 60,
                "alignment": "right",
                "margin": [10, 0, -10, 0]
              }
            ]
          ]
        },
        "layout": "noBorders"
      },
      {
        "style": "noc-table",
        "table": {
          "widths": ["55%", "45%"],
          "body": [
            [
              {
                "stack": [
                  { "text": "To,", "margin": [0, 0, 0, 0] },
                  { "text": "{{applicantName}}", "margin": [10, 0, 0, 0] },
                  { "text": "{{payerAddress}}", "margin": [10, 0, 0, 0] }
                ],
                "style": "receipt-table",
                "alignment": "left",
                "border": [false, false, false, false],
                "margin": [0, 0, 0, 0]
              },
              {
                "text": "Booking No: {{consumerID}}",
                "style": "receipt-table-value",
                "alignment": "right",
                "border": [false, false, false, false],
                "margin": [0, 0, 10, 0],
                "font": "Roboto"
              }
            ]
          ]
        },
        "layout": "noBorders"
      },
      {
        "style": "noc-table",
        "table": {
          "widths": ["100%"],
          "body": [
            [
              {
                "stack": [
                  {
                    "text": "Subject: Permission to use the Community Hall {{communityHallName}} Holding for {{purpose}} purpose",
                    "style": "receipt-table",
                    "alignment": "left",
                    "margin": [0, 0, 0, 0],
                    "bold": true
                  },
                  {
                    "text": "Dear {{applicantName}},",
                    "style": "receipt-table",
                    "alignment": "left",
                    "margin": [0, 0, 0, 0]
                  },
                  {
                    "text": "Permission is hereby accorded to use the following holding for the {{purpose}} purpose:",
                    "style": "receipt-table",
                    "alignment": "left",
                    "margin": [0, 0, 0, 0]
                  }
                ],
                "border": [false, false, false, false],
                "margin": [0, 0, 0, 0]
              }
            ]
          ]
        },
        "layout": "noBorders"
      },
      {
        "columns": [
          {
            "style": "next-noc-table",
            "table": {
              "widths": ["auto", "40%"],
              "body": [
                [
                  {
                    "text": "Payment Details:",
                    "bold": true,
                    "style": "receipt-table-value",
                    "border": [false, false, false, false],
                    "margin": [-26, 0, 0, 0]
                  },
                  {
                    "text": "",
                    "style": "receipt-table-value-down",
                    "border": [false, false, false, false]
                  }
                ],
                [
                  {
                    "text": "{{chb_booking_fees}}",
                    "style": "receipt-table-value-down",
                    "bold": true
                  },
                  {
                    "text": "₹{{chbBookingFees}}",
                    "style": "receipt-table-value-down"
                  }
                ],
                [
                  {
                    "text": "{{chb_sgst}} (9%)",
                    "style": "receipt-table-value-down",
                    "bold": true
                  },
                  {
                    "text": "₹{{chbSgst}}",
                    "style": "receipt-table-value-down"
                  }
                ],
                [
                  {
                    "text": "{{chb_cgst}} (9%)",
                    "bold": true,
                    "style": "receipt-table-value-down"
                  },
                  {
                    "text": "₹{{chbCgst}}",
                    "style": "receipt-table-value-down"
                  }
                ],
                [
                  {
                    "text": "{{chb_cow_cess}}",
                    "bold": true,
                    "style": "receipt-table-value-down"
                  },
                  {
                    "text": "₹{{chbCowCessCharge}}",
                    "style": "receipt-table-value-down"
                  }
                ],
                [
                  {
                    "text": "{{chb_service_charge}}",
                    "bold": true,
                    "style": "receipt-table-value-down"
                  },
                  {
                    "text": "₹{{chbServiceCharge}}",
                    "style": "receipt-table-value-down"
                  }
                ],
                [
                  {
                    "text": "{{chb_discount}}",
                    "bold": true,
                    "style": "receipt-table-value-down"
                  },
                  {
                    "text": "₹{{chbDiscountPositive}}",
                    "style": "receipt-table-value-down"
                  }
                ],
                [
                  {
                    "text": "{{total_amount}} (Rs)",
                    "bold": true,
                    "fillColor": "#f2f2f2",
                    "style": "receipt-table-value-down"
                  },
                  {
                    "text": "₹{{totalAmount}}",
                    "bold": true,
                    "fillColor": "#f2f2f2",
                    "style": "receipt-table-value-down"
                  }
                ]
              ]
            },
            "layout": {}
          },
          {
            "style": "next-noc-table",
            "table": {
              "widths": ["auto", "40%"],
              "body": [
                [
                  {
                    "text": "Booking Details",
                    "style": "receipt-table-value",
                    "bold": true,
                    "border": [false, false, false, false],
                    "alignment": "left",
                    "margin": [-4, 0, 0, 0]
                  },
                  {
                    "text": "",
                    "style": "receipt-table-value-down",
                    "alignment": "left",
                    "border": [false, false, false, false],
                    "margin": [0, 0, 0, 0]
                  }
                ],
                [
                  {
                    "text": "Hall Name",
                    "style": "receipt-table-value",
                    "bold": true,
                    "alignment": "left",
                    "margin": [0, 0, 0, 0]
                  },
                  {
                    "text": "{{communityHallName}}",
                    "style": "receipt-table-value-down",
                    "alignment": "left",
                    "margin": [0, 0, 0, 0]
                  }
                ],
                [
                  {
                    "text": "Date of Booking ",
                    "style": "receipt-table-value",
                    "bold": true,
                    "alignment": "left",
                    "margin": [0, 0, 0, 0]
                  },
                  {
                    "text": "{{dateNow}}",
                    "style": "receipt-table-value-down",
                    "alignment": "left",
                    "margin": [0, 0, 0, 0]
                  }
                ],
                "[{\"text\":\"Period of Booking \",\"style\":\"receipt-table-value\",\"bold\":true,\"alignment\":\"left\",\"border\":[true,true,true,true],\"margin\":[0,0,0,0]},{\"text\":\"{{#var_bookingSlots}}{{bookingDate}}  {{/var_bookingSlots}}\",\"style\":\"receipt-table-value-down\",\"alignment\":\"left\",\"border\":[true,true,true,true],\"margin\":[0,0,0,0]}]"
              ]
            },
            "layout": {}
          }
          
        ] ,
        "margin": [20, 0, 20, 0]
      },

