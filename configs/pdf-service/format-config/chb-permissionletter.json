      },
      "pt-disclaimer": {
        "fontSize": 10,
        "margin": [-27, 0, -10, 0],
        "color": "#484848"
      },
      "pt-disclaimer-value": {
        "fontSize": 9,
        "margin": [2, 0, 0, 0],
        "color": "#484848"
      }
