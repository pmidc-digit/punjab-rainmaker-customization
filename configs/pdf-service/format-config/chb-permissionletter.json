{
  "key": "chb-permissionletter",
  "config": {
    "defaultStyle": {
      "font": "Cambay"
    },
    "content": [
      {
        "style": "noc-head",
        "table": {
          "widths": [60, "*", 120],
          "body": [
            [
              {
                "image": "{{logoImage}}",
                "width": 50,
                "height": 61.25
              },
              {
                "stack": [
                  {
                    "text": "{{logo-header}} {{Municipal_Corporation}}",
                    "style": "receipt-logo-header"
                  },
                  {
                    "text": "{{serviceType}} Permission Letter",
                    "style": "receipt-logo-sub-header"
                  }
                ],
                "alignment": "left",
                "margin": [0, 10, 0, 0]
              },
              {
                "stack": [
                  {
                    "text": "{{address}}"
                  },
                  {
                    "text": "{{phoneNumber}}"
                  },
                  {
                    "text": "{{website}}"
                  },
                  {
                    "text": "{{email}}"
                  }
                ],
                "alignment": "right",
                "color": "#484848",
                "margin": [-100, 0, -25, 0]
              }
            ]
          ]
        },
        "layout": "noBorders"
      },
      {
        "style": "noc-table",
        "table": {
          "widths": ["55%", "45%"],
          "body": [
            [
              {
                "text": "",
                "border": [false, false, false, false]
              },
              {
                "text": "Booking No: {{consumerID}}",
                "style": "receipt-table-value",
                "alignment": "right",
                "border": [false, false, false, false],
                "margin": [0, 5, 10, 5]
              }
            ],
            [
              {
                "stack": [
                  { "text": "To,", "margin": [0, 0, 0, 2] },
                  { "text": "{{payerName}}", "margin": [20, 0, 0, 2] },
                  { "text": "{{payerAddress}}", "margin": [20, 0, 0, 2] }
                ],
                "style": "receipt-table",
                "alignment": "left",
                "border": [false, false, false, false],
                "margin": [10, 0, 0, 0]
              },
              {
                "image": "{{qrcodeimage}}",
                "width": 72,
                "height": 72,
                "alignment": "right",
                "margin": [0, 0, 10, 0],
                "border": [false, false, false, false]
              }
            ]
          ]
        },
        "layout": "noBorders"
      },
      {
        "style": "noc-table",
        "table": {
          "widths": ["100%"],
          "body": [
            [
              {
                "stack": [
                  {
                    "text": "Subject: Permission to use the Community Hall {{communityHallName}} {{hallCode}} Holding for {{purpose}} purpose",
                    "style": "receipt-table",
                    "alignment": "left",
                    "margin": [0, 0, 0, 5],
                    "bold": true
                  },
                  {
                    "text": "Dear {{payerName}},",
                    "style": "receipt-table",
                    "alignment": "left",
                    "margin": [0, 0, 0, 10]
                  },
                  {
                    "text": "Permission is hereby accorded to use the following holding for the {{purpose}} purpose:",
                    "style": "receipt-table",
                    "alignment": "left",
                    "margin": [0, 0, 0, 10]
                  }
                ],
                "border": [false, false, false, false],
                "margin": [0, 5, 0, 5]
              }
            ]
          ]
        },
        "layout": "noBorders"
      },

      {
        "style": "next-noc-table",
        "table": {
          "widths": ["40%", "60%"],
          "body": [
            [
              {
                "text": "Area / Accommodation Booked :",
                "style": "receipt-table-value",
                "bold": true,
                "alignment": "left",
                "border": [false, false, false, false],
                "margin": [8, 4, 0, 4]
              },
              {
                "text": "{{communityHallName}} - {{hallCode}}",
                "style": "receipt-table-value-down",
                "alignment": "left",
                "border": [false, false, false, false],
                "margin": [8, 4, 0, 4]
              }
            ],
            [
              {
                "text": "Date of Booking :",
                "style": "receipt-table-value",
                "bold": true,
                "alignment": "left",
                "border": [false, false, false, false],
                "margin": [8, 4, 0, 4]
              },
              {
                "text": "{{bookingDate}}",
                "style": "receipt-table-value-down",
                "alignment": "left",
                "border": [false, false, false, false],
                "margin": [8, 4, 0, 4]
              }
            ],
            "[{\"text\":\"Period of Booking :\",\"style\":\"receipt-table-value\",\"bold\":true,\"alignment\":\"left\",\"border\":[false,false,false,false],\"margin\":[8,4,0,4]},{\"text\":\"{{#var_bookingSlots}}{{bookingDate}}, {{/var_bookingSlots}}\",\"style\":\"receipt-table-value-down\",\"alignment\":\"left\",\"border\":[false,false,false,false],\"margin\":[8,4,0,4]}]"
          ]
        },
        "layout": {}
      },
      {
        "style": "next-noc-table",
        "table": {
          "widths": ["60%", "40%"],
          "body": [
            [
              {
                "text": "{{chb_booking_fees}}",
                "border": [true, true, false, false],
                "style": "receipt-table-value-down"
              },
              {
                "text": "{{chbBookingFees}}",
                "border": [false, true, true, false],
                "style": "receipt-table-value-down"
              }
            ],
            [
              {
                "text": "{{chb_sgst}}",
                "border": [true, false, false, false],
                "style": "receipt-table-value-down"
              },
              {
                "text": "{{chbSgst}}",
                "border": [false, false, true, false],
                "style": "receipt-table-value-down"
              }
            ],
            [
              {
                "text": "{{chb_cgst}}",
                "border": [true, false, false, false],
                "style": "receipt-table-value-down"
              },
              {
                "text": "{{chbCgst}}",
                "border": [false, false, true, false],
                "style": "receipt-table-value-down"
              }
            ],
            [
              {
                "text": "{{chb_service_charge}}",
                "border": [true, false, false, false],
                "style": "receipt-table-value-down"
              },
              {
                "text": "{{chbServiceCharge}}",
                "border": [false, false, true, false],
                "style": "receipt-table-value-down"
              }
            ],
            [
              {
                "text": "{{chb_discount}}",
                "border": [true, false, false, false],
                "style": "receipt-table-value-down"
              },
              {
                "text": "{{chbDiscount}}",
                "border": [false, false, true, false],
                "style": "receipt-table-value-down"
              }
            ],
            [
              {
                "text": "{{total_amount}}",
                "border": [true, false, false, true],
                "bold": true,
                "style": "receipt-table-value-down"
              },
              {
                "text": "{{totalAmount}}",
                "border": [false, false, true, true],
                "bold": true,
                "style": "receipt-table-value-down"
              }
            ]
          ]
        },
        "layout": {}
      },
      {
        "style": "next-noc-table",
        "table": {
          "widths": ["100%"],
          "body": [
            [
              {
                "text": "TERMS AND CONDITIONS",
                "bold": true,
                "style": "receipt-table-value-down",
                "alignment": "left",
                "border": [false, false, false, false],
                "margin": [0, 6, 0, 6]
              }
            ],
            [
              {
                "stack": [
                  { "text": "{{term_1}}", "margin": [0, 2, 0, 2] },
                  { "text": "{{term_2}}", "margin": [0, 2, 0, 2] },
                  { "text": "{{term_3}}", "margin": [0, 2, 0, 2] },
                  { "text": "{{term_4}}", "margin": [0, 2, 0, 2] },
                  { "text": "{{term_5}}", "margin": [0, 2, 0, 2] },
                  { "text": "{{term_6}}", "margin": [0, 2, 0, 2] },
                  { "text": "{{term_7}}", "margin": [0, 2, 0, 2] },
                  { "text": "{{term_8}}", "margin": [0, 2, 0, 2] },
                  { "text": "{{term_9}}", "margin": [0, 2, 0, 2] },
                  { "text": "{{term_10}}", "margin": [0, 2, 0, 2] },
                  { "text": "{{term_11}}", "margin": [0, 2, 0, 2] },
                  { "text": "{{term_12}}", "margin": [0, 2, 0, 2] },
                  { "text": "{{term_13}}", "margin": [0, 2, 0, 2] },
                  { "text": "{{term_14}}", "margin": [0, 2, 0, 2] },
                  { "text": "{{term_15}}", "margin": [0, 2, 0, 2] },
                  { "text": "{{term_16}}", "margin": [0, 2, 0, 2] },
                  { "text": "{{term_17}}", "margin": [0, 2, 0, 2] }
                ],
                "style": "receipt-table",
                "alignment": "left",
                "border": [false, false, false, false],
                "margin": [10, 6, 10, 6]
              }
            ]
          ]
        },
        "layout": "noBorders"
      },
      {
        "style": "receipt-approver",
        "columns": [
          {
            "text": [
              {
                "text": "{{generated_by}}: ",
                "bold": true
              },
              {
                "text": "{{user-name}}",
                "bold": false
              }
            ],
            "alignment": "left"
          }
        ]
      },
      {
        "style": "no-signature",
        "text": "{{no_signature}}"
      }
    ],
    "styles": {
      "noc-head": {
        "margin": [-30, -30, 0, 1]
      },
      "receipt-logo-header": {
        "color": "#000000",
        "fontSize": 14,
        "bold": true,
        "letterSpacing": 0.74,
        "margin": [0, 0, 0, 5]
      },
      "receipt-logo-sub-header": {
        "color": "#000000",
        "fontSize": 12,
        "letterSpacing": 0.6
      },
      "noc-table": {
        "fontSize": 12,
        "color": "#000000",
        "margin": [-25, 10, -22, -8]
      },
      "receipt-table-value-total-Qr": {
        "alignment": "right",
        "margin": [0, 3, 10, 0]
      },
      "receipt-table-value-down": {
        "color": "#000000",
        "bold": false,
        "fontSize": 12,
        "fontWeight": 400,
        "alignment": "left",
        "margin": [3, 5, 0, 5]
      },
      "next-noc-table": {
        "fontSize": 12,
        "color": "#000000",
        "margin": [-25, 28, -22, -8]
      },
      "receipt-table-value": {
        "color": "#000000",
        "bold": true,
        "fontSize": 12,
        "fontWeight": 500,
        "margin": [-2, 2, 0, 2]
      },
      "receipt-table": {
        "color": "#000000",
        "bold": false,
        "fontSize": 12,
        "fontWeight": 400,
        "margin": [-30, 2, 0, 2]
      },
      "receipt-approver": {
        "fontSize": 12,
        "bold": true,
        "margin": [-27, 50, -10, 0],
        "color": "#484848"
      },
      "no-signature": {
        "fontSize": 12,
        "margin": [-27, 35, -10, 0],
        "color": "#484848"
      },
      "pt-disclaimer": {
        "fontSize": 12,
        "margin": [-27, 30, -10, 0],
        "color": "#484848"
      },
      "pt-disclaimer-value": {
        "fontSize": 12,
        "margin": [2, 3, 0, 0],
        "color": "#484848"
      }
    }
  }
}
