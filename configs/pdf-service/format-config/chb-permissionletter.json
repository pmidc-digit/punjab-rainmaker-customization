                  }
                ],
                "style": "receipt-table",
                "alignment": "left",
                "border": [false, false, false, false],
                "margin": [10, 2, 10, 2]
              }
            ]
          ]
        },
        "layout": "noBorders"
      },
      {
        "style": "receipt-approver",
        "columns": [
          {
            "text": [
              {
                "text": "{{generated_by}}: ",
                "bold": true
              },
              {
                "text": "{{user-name}}",
                "bold": false
              }
            ],
            "alignment": "left"
          }
        ]
      },
      {
        "style": "no-signature",
        "text": "This is a computer generated letter , no signature is required.",
        "alignment": "center"
      }
    ],
    "styles": {
      "noc-head": {
        "margin": [-30, -30, 0, 1]
      },
      "receipt-logo-header": {
        "color": "#000000",
        "fontSize": 12,
        "bold": true,
        "letterSpacing": 0.74,
        "margin": [0, 0, 0, 2]
      },
      "receipt-logo-sub-header": {
        "color": "#000000",
        "fontSize": 11,
        "letterSpacing": 0.6
      },
      "noc-table": {
        "fontSize": 11,
        "color": "#000000",
        "margin": [-25, 0, -22, 0]
      },
      "receipt-table-value-total-Qr": {
        "alignment": "right",
        "margin": [0, 3, 10, 0]
      },
      "receipt-table-value-down": {
        "color": "#000000",
        "bold": false,
        "fontSize": 9,
        "fontWeight": 400,
        "alignment": "left",
        "margin": [3, 0, 0, 0]
      },
      "next-noc-table": {
        "fontSize": 10,
        "color": "#000000",
        "margin": [-25, 0, -22, 0]
      },
      "receipt-table-value": {
        "color": "#000000",
        "bold": true,
        "fontSize": 9,
        "fontWeight": 500,
        "margin": [-2, 0, 0, 0]
      },
      "receipt-table": {
        "color": "#000000",
        "bold": false,
        "fontSize": 9,
        "fontWeight": 400,
        "margin": [-30, 0, 0, 0]
      },
      "receipt-approver": {
        "fontSize": 9,
