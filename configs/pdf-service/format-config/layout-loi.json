{
  "key": "layout-loi",
  "config": {
    "content": [
      {
        "style": "loi-office-header",
        "stack": [
          {
            "text": "Office of The {{officeName}}",
            "bold": true,
            "alignment": "center",
            "fontSize": 12
          },
          {
            "text": "({{officeSubLine}}).",
            "alignment": "center",
            "fontSize": 11
          }
        ]
      },

      {
        "style": "loi-from-block",
        "stack": [
          { "text": "From", "bold": true },
          { "text": "The Competent Authority,", "margin": [20, 4, 0, 0] },
          {
            "text": "Under Punjab Apartment and Property Regulation Act, 1995",
            "margin": [20, 0, 0, 0]
          },
          {
            "text": "{{jurisdictionName}}.",
            "margin": [20, 0, 0, 0]
          }
        ]
      },

      {
        "style": "loi-to-block",
        "stack": [
          { "text": "To", "bold": true, "margin": [0, 10, 0, 0] },
          { "text": "{{applicantName}}", "margin": [20, 4, 0, 0] },
          { "text": "{{applicantAddress}},", "margin": [20, 0, 0, 0] },
          { "text": "{{promoterFirmName}}", "margin": [20, 0, 0, 0] }
        ]
      },

      {
        "style": "loi-memo-table",
        "table": {
          "widths": ["50%", "50%"],
          "body": [
            [
              {
                "text": [
                  { "text": "Memo No. ", "bold": true },
                  { "text": "{{consumerID}}" }
                ]
              },
              {
                "text": [
                  { "text": "Dated: ", "bold": true },
                  { "text": "{{issueDate}}" }
                ],
                "alignment": "right"
              }
            ]
          ]
        },
        "layout": "noBorders"
      },

      {
        "style": "loi-subject",
        "text": [
          { "text": "Subject: ", "bold": true },
          {
            "text": "Issue of Letter of Intent for setting up a {{colonyTypeName}} Colony to {{promoterFirmName}} — {{projectDescription}} — Under Rule 11(3) of PAPRA Rules, 1985"
          }
        ]
      },

      { "text": "*****", "alignment": "center", "margin": [0, 6, 0, 6] },

      {
        "style": "loi-para",
        "text": "Reference your application No. {{consumerID}} dated {{submissionDate}}, received in this office on {{submissionDate}}, for the grant of a License to set up a {{colonyTypeName}} Colony project — {{projectDescription}}."
      },

      {
        "style": "loi-para",
        "text": "It is proposed to grant a license to you for setting up a {{colonyTypeName}} Colony project — {{projectDescription}} — as per the layout plan submitted by you bearing Drawing No. {{dcrNo}} dated {{dcrApprovalDate}}. You are therefore called upon to fulfil all the conditions laid down in Rule 12 of the Punjab Apartment and Property Regulation Act, 1995, and the other conditions given below, within a period of {{complianceDays}} days from the date of service of this notice."
      },

      {
        "style": "loi-conditions",
        "ol": [
          "{{loi_1}}",
          "{{loi_2}}",
          "{{loi_3}}",
          "{{loi_4a}} {{jurisdictionName}} {{loi_4b}} {{jurisdictionName}} {{loi_4c}}",
          "{{loi_5a}} {{ulbType}}, {{ulbName}} {{loi_5b}}",
          "{{loi_6a}} {{ulbType}}, {{ulbName}} {{loi_6b}} {{ulbType}}, {{ulbName}}.",
          "{{loi_7}}",
          "{{loi_8}}",
          "{{loi_9}}",
          "{{loi_10a}} {{projectDescription}} {{loi_10b}} {{ulbType}}, {{ulbName}} {{loi_10c}} {{ulbType}}, {{ulbName}} {{loi_10d}} {{ulbType}}, {{ulbName}} {{loi_10e}}",
          "{{loi_11a}} {{ulbName}} {{loi_11b}}",
          "{{loi_12}}",
          "{{loi_13}}",
          "{{loi_14}}",
          "{{loi_15}}",
          "{{loi_16a}} {{officerDesignation}}, {{ulbType}}, {{ulbName}} {{loi_16b}}",
          "{{loi_17}}",
          "{{loi_18a}} {{ulbType}}, {{ulbName}} {{loi_18b}} {{ulbType}}, {{ulbName}} {{loi_18c}}",
          "{{loi_19}}",
          "{{loi_20}}",
          "{{loi_21}}",
          "{{loi_22a}} {{ulbName}} {{loi_22b}}",
          "{{loi_23}}",
          "{{loi_24}}",
          "{{loi_25a}} {{ulbType}}, {{ulbName}} {{loi_25b}}",
          "{{loi_26}}",
          "{{loi_27}}",
          "{{loi_28}}",
          "{{loi_29}}",
          "{{loi_30}}",
          "{{loi_31}}",
          "{{loi_32}}",
          "{{loi_33}}",
          "{{loi_34a}} {{officerDesignation}}, {{ulbType}}, {{ulbName}} {{loi_34b}}",
          "{{loi_35}}",
          "{{loi_36}}",
          "{{loi_37}}",
          "{{loi_38}}",
          "{{loi_39}}"
        ],
        "margin": [20, 4, 0, 10]
      },

      {
        "style": "loi-para",
        "text": "If you fail to comply with any of the conditions of this LOI within the stipulated period of {{complianceDays}} days, or the extended period of a further {{extensionDays}} days if granted by the Competent Authority, this LOI shall be deemed to be cancelled and you will have to apply afresh for the LOI."
      },

      {
        "style": "loi-signature",
        "stack": [
          { "text": "Competent Authority", "alignment": "right" },
          { "text": "{{signatoryDesignation}}", "alignment": "right" }
        ]
      },

      {
        "style": "loi-endst",
        "text": [
          { "text": "Endst. No.: PAPRA/({{consumerID}})", "bold": true },
          { "text": "    Dated: {{issueDate}}" }
        ]
      },

      {
        "style": "loi-para",
        "text": "A copy of the above, along with a copy of the complete set submitted by the applicant, is forwarded to the following for information and necessary action regarding issuance of NOC as per the rules, regulations and guidelines:"
      },

      {
        "style": "loi-copyto",
        "ol": [
          "{{loi_c1}}",
          "{{loi_c2}}",
          "{{loi_c3}}",
          "{{officerDesignation}}, {{ulbType}}, {{ulbName}}.",
          "{{loi_c5}}"
        ],
        "margin": [20, 4, 0, 10]
      },

      {
        "text": "Competent Authority",
        "alignment": "right",
        "margin": [0, 6, 0, 10]
      },

      {
        "style": "loi-endst",
        "text": [
          { "text": "Endst. No.: PAPRA/({{consumerID}})", "bold": true },
          { "text": "    Dated: {{issueDate}}" }
        ]
      },

      {
        "style": "loi-para",
        "text": "A copy of the above is forwarded to the Deputy Commissioner, {{districtName}}, for information and necessary action."
      },

      { "text": "Competent Authority", "alignment": "right" }
    ],

    "styles": {
      "loi-office-header": { "margin": [0, 0, 0, 10] },
      "loi-from-block": {
        "fontSize": 11,
        "color": "#000000",
        "margin": [0, 6, 0, 4]
      },
      "loi-to-block": {
        "fontSize": 11,
        "color": "#000000",
        "margin": [0, 0, 0, 10]
      },
      "loi-memo-table": {
        "fontSize": 11,
        "color": "#000000",
        "margin": [0, 0, 0, 6]
      },
      "loi-subject": {
        "fontSize": 11,
        "color": "#000000",
        "margin": [0, 4, 0, 4]
      },
      "loi-para": {
        "fontSize": 11,
        "color": "#000000",
        "alignment": "justify",
        "margin": [0, 0, 0, 8]
      },
      "loi-conditions": {
        "fontSize": 10.5,
        "color": "#000000",
        "alignment": "justify"
      },
      "loi-copyto": {
        "fontSize": 10.5,
        "color": "#000000",
        "alignment": "justify"
      },
      "loi-signature": {
        "fontSize": 11,
        "bold": true,
        "color": "#000000",
        "margin": [0, 10, 0, 10]
      },
      "loi-endst": {
        "fontSize": 11,
        "color": "#000000",
        "margin": [0, 8, 0, 4]
      }
    }
  }
}
